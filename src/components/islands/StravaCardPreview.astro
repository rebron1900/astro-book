---
import { Bike, Dumbbell, Footprints, Mountain, Waves } from '@lucide/astro';

type SportKey = 'run' | 'ride' | 'walk' | 'hike' | 'climb' | 'swim' | 'other';

interface Props {
    activity: { name: string };
    route: { path: string; startX: number; startY: number; endX: number; endY: number } | null;
    meta: {
        key: SportKey;
        label: string;
        stats: Array<{ label: string; value: string; primary?: boolean }>;
    };
    /** 可选：运动记录 id（渲染为 data-exercise-id，供运动页面做联动） */
    dataId?: string;
    /** 可选：记录日期（渲染为 data-date） */
    dataDate?: string;
    /** 可选：运动类型（渲染为 data-sport，供筛选器使用） */
    dataSport?: string;
}

const { activity, route, meta, dataId, dataDate, dataSport } = Astro.props as Props;

const SPORT_ICONS: Record<SportKey, any> = {
    run: Footprints,
    ride: Bike,
    walk: Footprints,
    hike: Mountain,
    climb: Mountain,
    swim: Waves,
    other: Dumbbell
};

const SportIcon = SPORT_ICONS[meta.key] ?? Footprints;
---

<div class:list={['strava-card', `sport-${meta.key}`]} data-exercise-id={dataId} data-date={dataDate} data-sport={dataSport}>
    {route && (
        <svg class="strava-route" viewBox="0 0 620 120" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <path d={route.path} />
            <circle cx={route.startX} cy={route.startY} r="2.4" />
            <circle cx={route.endX} cy={route.endY} r="2.4" />
        </svg>
    )}
    <div class="strava-content">
        <div class="strava-head">
            <div class="strava-title-row">
                <SportIcon class="strava-sport-icon" size={14} aria-hidden="true" />
                <span class="strava-sport-name">{meta.label}</span>
                <h2 class="entry-title">{activity.name}</h2>
            </div>
        </div>
        <dl class="stats strava-stats">
            {meta.stats.map((stat) => (
                <div class:list={{ 'is-primary': stat.primary }}>
                    <dt>{stat.label}</dt>
                    <dd>{stat.value}</dd>
                </div>
            ))}
        </dl>
    </div>
</div>
