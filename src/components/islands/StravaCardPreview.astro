---
import type { StravaStat } from '../../lib/strava-preview';
import MetricIcon from '../ui/MetricIcon.astro';

type SportKey = 'run' | 'ride' | 'walk' | 'hike' | 'climb' | 'swim' | 'stair' | 'other';

interface Props {
    activity: { name: string };
    route: { path: string; startX: number; startY: number; endX: number; endY: number } | null;
    meta: {
        key: SportKey;
        label: string;
        stats: StravaStat[];
    };
    /** 可选：运动记录 id（渲染为 data-exercise-id，供运动页面做联动） */
    dataId?: string;
    /** 可选：记录日期（渲染为 data-date） */
    dataDate?: string;
    /** 可选：运动类型（渲染为 data-sport，供筛选器使用） */
    dataSport?: string;
    /** 可选：是否在每项指标标签前显示小图标（运动页开启，首页保持原有排版） */
    metricIcons?: boolean;
}

const { activity, route, meta, dataId, dataDate, dataSport, metricIcons = false } = Astro.props as Props;

/** 卡片图标走整页一份的 sprite（见 ui/CardSprite.astro）：每个图标从 530 字节降到一行 <use> */
const SPORT_ICON_IDS: Record<SportKey, string> = {
    run: '#ci-footprints',
    ride: '#ci-bike',
    walk: '#ci-footprints',
    hike: '#ci-mountain',
    climb: '#ci-mountain',
    swim: '#ci-footprints',
    stair: '#ci-footprints',
    other: '#ci-dumbbell'
};

const sportIconId = SPORT_ICON_IDS[meta.key] ?? '#ci-footprints';
---

<div class:list={['strava-card', `sport-${meta.key}`]} data-exercise-id={dataId} data-date={dataDate} data-sport={dataSport}>
    {route && (
        <svg class="strava-route" viewBox="0 0 620 120" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            <path d={route.path} />
            <circle cx={route.startX} cy={route.startY} r="2.4" />
            <circle cx={route.endX} cy={route.endY} r="2.4" />
        </svg>
    )}
    <div class="strava-content">
        <div class="strava-head">
            <div class="strava-title-row">
                <svg class="strava-sport-icon" viewBox="0 0 24 24" aria-hidden="true"><use href={sportIconId} /></svg>
                <span class="strava-sport-name">{meta.label}</span>
                <h2 class="entry-title">{activity.name}</h2>
            </div>
        </div>
        <dl class="stats strava-stats">
            {meta.stats.map((stat) => (
                <div class:list={{ 'is-primary': stat.primary }}>
                    <dt>{metricIcons && <MetricIcon kind={stat.kind} />}{stat.label}</dt>
                    <dd>{stat.value}</dd>
                </div>
            ))}
        </dl>
    </div>
</div>
