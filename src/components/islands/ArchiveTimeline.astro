---
import type { Post } from '@ts-ghost/content-api';
import { BookOpenText } from '@lucide/astro';
import { normalizeData, normalizeSlug } from '../../lib/utils/help';
import '../../styles/pages/archives.scss';

type ArchivePost = Post & { type?: string };

const { posts } = Astro.props as { posts: ArchivePost[] };

type MonthGroup = {
    key: string;
    year: string;
    month: string;
    items: ArchivePost[];
};

const groups = new Map<string, MonthGroup>();

posts.forEach((post) => {
    const date = new Date(post.published_at ?? post.created_at);
    if (Number.isNaN(date.getTime())) return;
    const year = String(date.getFullYear());
    const month = String(date.getMonth() + 1).padStart(2, '0');
    const key = `${year}-${month}`;
    let group = groups.get(key);
    if (!group) {
        group = { key, year, month, items: [] };
        groups.set(key, group);
    }
    group.items.push(post);
});

const months = [...groups.values()]
    .map((group) => ({
        ...group,
        items: [...group.items].sort(
            (a, b) => new Date(b.published_at ?? b.created_at).getTime() - new Date(a.published_at ?? a.created_at).getTime()
        )
    }))
    .sort((a, b) => {
        if (a.year !== b.year) return Number(b.year) - Number(a.year);
        return Number(b.month) - Number(a.month);
    });

function cardDate(post: ArchivePost) {
    return normalizeData(post.published_at ?? post.created_at) ?? '';
}

function visibleTags(post: ArchivePost) {
    return (post.tags ?? []).filter((tag) => tag.visibility !== 'internal');
}
---

<div class="archive-timeline" data-archive-timeline>
    {months.map((group) => (
        <section class="archive-month-section" data-month-key={group.key}>
            <div class="archive-month-date">
                <span class="archive-month-year">{group.year}</span>
                <span class="archive-month-value">{group.month}月</span>
                <span class="archive-month-count">{group.items.length} 篇</span>
            </div>
            <div class="archive-month-rail" aria-hidden="true">
                <span class="rail-marker"><BookOpenText /></span>
            </div>
            <div class="archive-month-content">
                <div class="archive-card-grid">
                    {group.items.map((post) => (
                        <a class="archive-card" href={normalizeSlug(post.slug)} data-full-title={post.title}>
                            <h2 class="archive-card-title" data-archive-title data-full-title={post.title}>{post.title}</h2>
                            <div class="archive-card-meta">
                                <time datetime={cardDate(post)}>{cardDate(post)}</time>
                                {visibleTags(post).length > 0 && (
                                    <span class="archive-card-tags">
                                        {visibleTags(post).map((tag) => (
                                            <span class="archive-tag">#{tag.name}</span>
                                        ))}
                                    </span>
                                )}
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    ))}
</div>

<script>
    import { onPageLoad } from '../../lib/client/mount';

    const markClippedArchiveTitles = () => {
        document.querySelectorAll<HTMLElement>('[data-archive-title]').forEach((title) => {
            const card = title.closest<HTMLElement>('.archive-card');
            if (!card || card.dataset.titleClippedReady === 'true') return;
            card.dataset.titleClippedReady = 'true';
            const mark = () => {
                if (title.scrollHeight > title.clientHeight + 1) card.dataset.titleClipped = 'true';
            };
            mark();
            card.addEventListener('pointerenter', mark);
            card.addEventListener('focusin', mark);
        });
    };

    const bootArchiveTitleClipping = () => requestAnimationFrame(markClippedArchiveTitles);

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let archiveRevealObserver: IntersectionObserver | null = null;

    if (!reduceMotion && 'IntersectionObserver' in window) {
        archiveRevealObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (!entry.isIntersecting) return;
                    entry.target.classList.add('is-visible');
                    archiveRevealObserver?.unobserve(entry.target);
                });
            },
            { rootMargin: '0px 0px -5% 0px', threshold: 0.04 }
        );
    }

    const setupArchiveReveal = (root: ParentNode = document) => {
        root.querySelectorAll<HTMLElement>('.archive-card:not([data-archive-reveal])').forEach((card) => {
            card.dataset.archiveReveal = 'true';
            if (!archiveRevealObserver) {
                card.classList.add('is-visible');
                return;
            }
            card.classList.add('archive-reveal-ready');
            archiveRevealObserver.observe(card);
        });
    };

    const bootArchiveReveal = () => requestAnimationFrame(() => setupArchiveReveal());

    onPageLoad(() => {
        bootArchiveTitleClipping();
        bootArchiveReveal();
    });
</script>

