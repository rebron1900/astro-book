---
import { stravaMetaFor, routeSketch } from '../../lib/strava-preview';
import StravaCardPreview from './StravaCardPreview.astro';

const { activity } = Astro.props;
const activityUrl = activity.url || `https://www.strava.com/activities/${activity.run_id}`;
const href = `/golink?target=${btoa(unescape(encodeURIComponent(activityUrl)))}`;
---

<StravaCardPreview
    activity={activity}
    route={routeSketch(activity.summary_polyline)}
    meta={stravaMetaFor(activity)}
    href={href}
/>
