---
import { stravaMetaFor, routeSketch } from '../../lib/strava-preview';
import StravaCardPreview from './StravaCardPreview.astro';

const { activity } = Astro.props;
const href = `/golink?target=${btoa(unescape(encodeURIComponent(`https://www.strava.com/activities/${activity.run_id}`)))}`;
---

<StravaCardPreview
    activity={activity}
    route={routeSketch(activity.summary_polyline)}
    meta={stravaMetaFor(activity)}
    href={href}
/>
