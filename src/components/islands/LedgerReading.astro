---
/**
 * 时间线「阅读」卡片：一本书一天一张，沿用书影音卡片的几何（.reading-card 复用 neodb 那套样式）。
 *
 * 主信息是这一天的阅读量：第一行是分钟数（左）+ 划线图标与条数（右），书名与作者同一行
 * （书名可省略、作者先限宽 46%），下面是两行简介。
 * 进度条在卡片最底部、横跨内容区整宽，只有 4px 细条，轨道上下各留 8.8px；百分比做成小气泡挂在
 * 轨道下方（absolute、不进文档流）。条和气泡按进度取语义色（见 PROGRESS_TIERS）：
 * <34% 红、34–66% 黄、≥67% 蓝。真实进度已到 100%（即最后一天）的卡照样留满条（蓝），但不出气泡、不显示 100%。
 * 进度口径：position 只有「最后一次同步」那个点是真的，其余日期按累计阅读时长推算，
 * 推算值前加 `≈`，aria-label / title 里写明「按阅读时长推算」。
 * 划线入口是 SVG 引号图标 + 条数，和分钟数同一行、靠右；悬停或键盘聚焦弹出面板，
 * 走全站同一套 tippy（createTippy + theme 'auto'，appendTo body）——面板挂到 body 上，
 * 不会被卡片裁掉，样式也和站内其它 tooltip 一致。交互见 reading-tips.ts。
 * 划线 HTML 构建期生成（先转义、无 HTML 透传），这里以字符串交给 tippy 的 content。
 */
import { renderHighlights, shortDuration } from '../../lib/reading-highlights';
import { TextQuote } from '@lucide/astro';
import { progressTier, showsProgressBadge, type ReadingDayBook } from '../../lib/reading';

interface Props {
    book: ReadingDayBook;
    date: string;
    index: number;
    coverUrl?: string | null;
}

const { book, date, index, coverUrl = null } = Astro.props;
const highlights = book.highlights ?? [];
const highlightsHtml = renderHighlights(highlights, date);
const hasHighlights = highlights.length > 0;
// 老板要「读了多少分钟」：统一给分钟数，超过一小时也不再换成小时，方便直接比较大小。
const minutes = Math.max(1, Math.round(book.seconds / 60));
const realProgress = typeof book.progress === 'number' ? book.progress : null;
// 展示值优先用推算值；与真实快照相等（最后一天，或恰好撞上）时不加 ≈。
const shownProgress = typeof book.progressEst === 'number' ? book.progressEst : realProgress;
const isEstimated = shownProgress !== null && shownProgress !== realProgress;
const progressText = shownProgress === null ? '' : `${isEstimated ? '≈' : ''}${shownProgress}%`;
// 已读完：真实快照和推算值都到 100（即最后一次同步那天）才认，避免把推算满当成读完。
// 已读完：真实快照和推算值都到 100（即最后一次同步那天）才认，避免把推算满当成读完；
// 读完的卡照样留满条（蓝），只是不出气泡、不显示 100%（判据集中在 showsProgressBadge）。
const showBadge = showsProgressBadge(shownProgress, realProgress);
const isCompleted = shownProgress !== null && !showBadge;
// 颜色分档只算出一个名字（danger/warning/info），具体颜色由 CSS 映射到 --hint-color-*。
const tier = shownProgress === null ? null : progressTier(shownProgress);
const progressLabel =
    shownProgress === null
        ? ''
        : isCompleted
          ? `《${book.title}》阅读进度 100%，已读完`
          : `《${book.title}》阅读进度 ${progressText}${isEstimated ? '，按阅读时长推算' : '，取自最后一次同步'}`;
// 划线入口的可访问名写全，视觉上只留图标 + 数字
const highlightsLabel = `${highlights.length} 条划线`;
---

<div class="reading-card neodb-card">
    <div class="cover">
        {coverUrl ? <img src={coverUrl} alt={`${book.title}封面`} loading="lazy" decoding="async" /> : <span aria-hidden="true">{book.title.slice(0, 1)}</span>}
    </div>
    <div class="media-info">
        <div class="reading-head">
            <p class="reading-stats">
                <span class="rd-stat" title={shortDuration(book.seconds)}>{isCompleted ? '已读完' : `已读 ${minutes} 分钟`}</span>
            </p>
            {hasHighlights && (
                <button
                    type="button"
                    class="rd-tip-trigger"
                    aria-label={highlightsLabel}
                    data-rd-trigger
                    data-rd-date={date}
                    data-rd-kind="reading"
                    data-tip-html={highlightsHtml}
                >
                    <TextQuote size={13} stroke-width={2} aria-hidden="true" />
                    <span class="rd-tip-count" aria-hidden="true">{highlights.length}</span>
                </button>
            )}
        </div>
        <h2 class="reading-titleline">
            <span class="entry-title" title={book.title}>{book.title}</span>
            {book.author && <span class="reading-author" title={book.author}>{book.author}</span>}
        </h2>
        {book.description && <p class="reading-desc">{book.description}</p>}
    </div>
    {shownProgress !== null && !isCompleted && (
        <div class="rd-progress" role="img" aria-label={progressLabel} title={progressLabel} data-tier={tier} style={`--p: ${shownProgress}%`}>
            <span class="rd-progress-fill" style={`inline-size: ${shownProgress}%`}></span>
            {showBadge && <span class="rd-progress-badge" aria-hidden="true">{progressText}</span>}
        </div>
    )}
</div>
