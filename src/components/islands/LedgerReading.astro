---
/**
 * 时间线「阅读」卡片：一本书一天一张，沿用书影音卡片的几何（.reading-card 复用 neodb 那套样式）。
 *
 * 主信息是这一天的阅读量：分钟数最显眼，其次是新增划线条数，再是这本书的阅读进度（百分比 + 细进度条）。
 * 下面才是书名 / 作者 / 两行简介。正文不再放划线引文——划线仍在右上角 SVG 的 hover 面板里。
 * 划线入口是卡片右上角的 SVG 图标：悬停或键盘聚焦才弹出面板，走全站同一套 tippy
 * （createTippy + theme 'auto'，appendTo body）——面板挂到 body 上，不会再被卡片裁掉，
 * 样式也和站内其它 tooltip 一致（全局 .tippy-box 卡片外观）。交互见 reading-tips.ts。
 * 划线 HTML 构建期生成（先转义、无 HTML 透传），这里以字符串交给 tippy 的 content。
 */
import { renderHighlights, shortDuration } from '../../lib/reading-highlights';
import { TextQuote } from '@lucide/astro';
import type { ReadingDayBook } from '../../lib/reading';

interface Props {
    book: ReadingDayBook;
    date: string;
    index: number;
    coverUrl?: string | null;
}

const { book, date, index, coverUrl = null } = Astro.props;
const highlights = book.highlights ?? [];
const highlightsHtml = renderHighlights(highlights, date);
const hasHighlights = highlights.length > 0;
// 老板要「读了多少分钟」：统一给分钟数，超过一小时也不再换成小时，方便直接比较大小。
const minutes = Math.max(1, Math.round(book.seconds / 60));
const progress = typeof book.progress === 'number' ? book.progress : null;
// 书名被截断时由 tippy 展示全名；没截断就不建实例，避免每个卡片都挂一个空 tooltip
const titleLabel = `${book.title} 的划线，共 ${highlights.length} 处`;
---

<div class="reading-card neodb-card">
    <div class="cover">
        {coverUrl ? <img src={coverUrl} alt={`${book.title}封面`} loading="lazy" decoding="async" /> : <span aria-hidden="true">{book.title.slice(0, 1)}</span>}
    </div>
    <div class="media-info">
        <p class="reading-stats">
            <span class="rd-stat rd-stat-duration" title={shortDuration(book.seconds)}>
                <strong>{minutes}</strong>
                <span class="rd-unit">分钟</span>
            </span>
            {hasHighlights && <span class="rd-stat rd-stat-highlights">新增 {highlights.length} 条划线</span>}
            {progress !== null && <span class="rd-stat rd-stat-progress">本书 {progress}%</span>}
        </p>
        {progress !== null && (
            <div class="rd-progress" role="img" aria-label={`《${book.title}》阅读进度 ${progress}%`}>
                <span class="rd-progress-fill" style={`inline-size: ${progress}%`}></span>
            </div>
        )}
        <h2 class="entry-title" title={book.title}>{book.title}</h2>
        {book.author && <p class="reading-author">{book.author}</p>}
        {book.description && <p class="reading-desc">{book.description}</p>}
        {hasHighlights && (
            <button
                type="button"
                class="rd-tip-trigger"
                aria-label={titleLabel}
                data-rd-trigger
                data-rd-date={date}
                data-rd-kind="reading"
                data-tip-html={highlightsHtml}
            >
                <TextQuote size={13} stroke-width={2} aria-hidden="true" />
            </button>
        )}
    </div>
</div>
