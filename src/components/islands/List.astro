---
import type { Memo } from '../../api/types';
import type { TimelineEntry } from '../../api/store';
import type { ReadingDayBook } from '../../lib/reading';
import type { Post } from '@ts-ghost/content-api';
import { normalizeSlug, cnDateKey, cnDayLabel, cnDateParts } from '../../lib/utils/help';
import { timelineVisible, TIMELINE_INCLUDE_NEODB } from '../../api/store';
import { countTimeline } from '../../lib/timeline';
import { BookHeart, BookOpenText, Clapperboard, Footprints, LibraryBig, MessageCircle } from '@lucide/astro';
import PostMeta from '../ui/PostMeta.astro';
import LedgerMemo from './LedgerMemo.astro';
import LedgerNeodb from './LedgerNeodb.astro';
import LedgerStrava from './LedgerStrava.astro';
import LedgerReading from './LedgerReading.astro';
import LedgerEmby from './LedgerEmby.astro';
import LedgerEmbyGroup from './LedgerEmbyGroup.astro';
import NeodbCategoryIcon from '../ui/NeodbCategoryIcon.astro';
import TimelineMonthList from './TimelineMonthList.astro';
import '../../styles/pages/timeline.scss';

type PostItem = Post & { type: string };
type RawItem = TimelineEntry | PostItem | Memo;

type FilterNavItem = { label: string; href: string; count: number; active?: boolean };
const { page, filterKind = 'all', filterNav = null, groupBy = 'day', monthCategory = 'all', showIntro = true, showToolbar = true, autoLoad = true } = Astro.props as {
    page: { data: RawItem[]; url?: { next?: string; prev?: string; current?: string }; currentPage?: number };
    filterKind?: string;
    filterNav?: FilterNavItem[] | null;
    groupBy?: 'day' | 'month';
    monthCategory?: string;
    showIntro?: boolean;
    showToolbar?: boolean;
    autoLoad?: boolean;
};
const url = new URL(Astro.request.url);
const isTimelinePage = page.data.some((item) => 'kind' in item);

function isTimelineEntry(raw: RawItem): raw is TimelineEntry {
    const kind = (raw as { kind?: unknown }).kind;
    return kind === 'post' || kind === 'memo' || kind === 'neodb' || kind === 'strava' || kind === 'reading' || kind === 'media';
}

function isMemo(raw: RawItem): raw is Memo {
    return typeof (raw as Memo).createdTs === 'number';
}

function toTimelineEntry(raw: RawItem): TimelineEntry {
    if (isTimelineEntry(raw)) return raw;
    if (isMemo(raw)) {
        return { kind: 'memo', time: raw.createdTs * 1000, data: raw };
    }
    const post = raw as PostItem;
    return {
        kind: 'post',
        time: new Date(post.published_at ?? post.created_at).getTime(),
        data: post
    };
}

const coverModules = import.meta.glob<{ default: { src: string } }>('../../assets/reading-cover/*.webp', { eager: true });
const coverByKey = new Map<string, string>();
for (const [file, mod] of Object.entries(coverModules)) {
    const key = file.split('/').pop()?.replace(/\.webp$/, '') ?? '';
    if (key) coverByKey.set(key, mod.default.src);
}

const entries = page.data.map(toTimelineEntry);
// 影视卡封面用站内已有的 reading-cover 真图（不外链 Emby）；按条目顺序循环取。
const mediaCovers = [...coverByKey.values()];
const mediaCoverById = new Map<string, string | null>(
    entries
        .filter((entry): entry is Extract<TimelineEntry, { kind: 'media' }> => entry.kind === 'media')
        .map((entry, index) => [
            entry.data.id,
            entry.data.cover ?? (mediaCovers.length ? mediaCovers[index % mediaCovers.length] : null)
        ])
);
const activeKind = ['post', 'memo', ...(TIMELINE_INCLUDE_NEODB ? ['neodb'] : []), 'strava', 'reading'].includes(filterKind) ? filterKind : 'all';
const filterHref = (kind: string) => (kind === 'all' ? '/' : `/timeline/${kind}/`);
// 计数只算时间线可见数据（TIMELINE_INCLUDE_NEODB=false 时 neodb 已剔除）；
// 「阅读与影视」= reading + media。
const timelineTotals = countTimeline(timelineVisible);
const readingMediaTotal = timelineTotals.readingAndMedia;

const timelineIntros = {
    all: {
        title: '沿着时间，慢慢往下读。',
        copy: '这里收录了博主的文章、随记、阅读与影视记录，也收录日常里值得留下的片段。所有内容按时间依次排列，左侧细线与类型图标标出每一天的开始；'
    },
    post: {
        title: '把想说的话，慢慢写下来。',
        copy: '这里放着我认真写下的长文章。有些是关于技术、折腾和工具的记录，有些只是生活里绕不开的念头。写完就放在这里，等有缘的人路过时读一读。'
    },
    memo: {
        title: '随手记下，日子就有了回声。',
        copy: '这里是一些没有来得及展开的片段：今天的天气、脑子里突然冒出的想法、路上看见的一棵树，以及那些不适合写成文章的小事。'
    },
    neodb: {
        title: '在别人的故事里，度过一些时间。',
        copy: '这里记下我看过的电影、读过的书、追过的剧和听过的音乐。喜欢的会多写两句，不喜欢的也留个脚印，算是给自己的一份观影与阅读账本。'
    },
    reading: {
        title: '翻过的页、看过的片，都算数。',
        copy: '这里记下我每天读了什么书、看了什么片，读了多久、看到哪一集。一本书一天一张卡片，一条观看记录一张卡片；没有记录的日子就不出现。'
    },
    strava: {
        title: '用身体，把日子往前推一点。',
        copy: '这里是我跑步、徒步、骑行和游泳的轨迹。它们谈不上什么成绩，只是每一次出门、流汗和回来的证据；路很长，慢慢走。'
    }
};
const intro = timelineIntros[activeKind as keyof typeof timelineIntros] ?? timelineIntros.all;
const currentYear = cnDateParts(Date.now()).year;

// 按真实类型收窄：分组后的条目一定是 strava 那条分支，data 才能当 Activity 用
const stravaGroupLeads = new Map<number, Array<Extract<TimelineEntry, { kind: 'strava' }>>>();
const stravaGroupMembers = new Set<number>();
entries.forEach((entry, index) => {
    if (entry.kind !== 'strava' || stravaGroupMembers.has(index)) return;
    const group = [entry];
    for (let nextIndex = index + 1; nextIndex < entries.length; nextIndex += 1) {
        const next = entries[nextIndex];
        if (next.kind !== 'strava' || dateKey(next.time) !== dateKey(entry.time)) break;
        group.push(next);
        stravaGroupMembers.add(nextIndex);
    }
    if (group.length > 1) stravaGroupLeads.set(index, group);
});

const neodbGroupLeads = new Map<number, TimelineEntry[]>();
const neodbGroupMembers = new Set<number>();
entries.forEach((entry, index) => {
    if (entry.kind !== 'neodb' || neodbGroupMembers.has(index)) return;
    const group = [entry];
    for (let nextIndex = index + 1; nextIndex < entries.length; nextIndex += 1) {
        const next = entries[nextIndex];
        if (next.kind !== 'neodb' || dateKey(next.time) !== dateKey(entry.time)) break;
        group.push(next);
        neodbGroupMembers.add(nextIndex);
    }
    if (group.length > 1) neodbGroupLeads.set(index, group);
});

// 同一天的影视条目合成一行，两列并排（一天连看多集时不再一集一行）
type MediaEntry = Extract<TimelineEntry, { kind: 'media' }>;
const mediaGroupLeads = new Map<number, MediaEntry[]>();
const mediaGroupMembers = new Set<number>();
entries.forEach((entry, index) => {
    if (entry.kind !== 'media' || mediaGroupMembers.has(index)) return;
    const group: MediaEntry[] = [entry];
    for (let nextIndex = index + 1; nextIndex < entries.length; nextIndex += 1) {
        const next = entries[nextIndex];
        if (next.kind !== 'media' || dateKey(next.time) !== dateKey(entry.time)) break;
        group.push(next);
        mediaGroupMembers.add(nextIndex);
    }
    if (group.length > 1) mediaGroupLeads.set(index, group);
});

type MediaCard = { kind: 'single'; entry: MediaEntry } | { kind: 'group'; entries: MediaEntry[] };

// 一天里同一部剧看了 2 集以上就合成一张聚合卡；只看了 1 集保持单集卡。
function mediaCardsOf(group: MediaEntry[]): MediaCard[] {
    const cards: MediaCard[] = [];
    const seriesPosition = new Map<string, number>();
    for (const item of group) {
        if (item.data.type !== 'episode') {
            cards.push({ kind: 'single', entry: item });
            continue;
        }
        const key = item.data.title;
        const position = seriesPosition.get(key);
        if (position === undefined) {
            seriesPosition.set(key, cards.length);
            cards.push({ kind: 'single', entry: item });
            continue;
        }
        const current = cards[position];
        if (current.kind === 'group') current.entries.push(item);
        else cards[position] = { kind: 'group', entries: [current.entry, item] };
    }
    return cards;
}
const WEEKDAYS = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];

function dateAt(time: number) {
    return new Date(time);
}

function dateKey(time: number) {
    return cnDateKey(time);
}

function dayLabel(time: number) {
    return cnDayLabel(time);
}

function weekday(time: number) {
    return WEEKDAYS[cnDateParts(time).weekday];
}

function fullDate(time: number) {
    const date = new Date(time + 8 * 60 * 60 * 1000);
    return `${dateKey(time)} ${String(date.getUTCHours()).padStart(2, '0')}:${String(date.getUTCMinutes()).padStart(2, '0')}`;
}

function excerptText(value: string | null | undefined, max = 150) {
    const text = (value ?? '').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
    if (text.length <= max) return text;
    return `${text.slice(0, max)}…`;
}
---

{isTimelinePage ? (
    <>
        {showIntro && (
            <header class="timeline-intro">
                <h2 class="timeline-intro-title">{intro.title}</h2>
                <p class="timeline-intro-copy">
                    {intro.copy}
                    {activeKind === 'strava' && (
                        <a class="timeline-intro-link" href="/activity/">
                            在地图上看看这些路线 →
                        </a>
                    )}
                </p>
            </header>
        )}

        {showToolbar && (
        <div class="timeline-toolbar" data-timeline-toolbar>
            {filterNav ? (
                <div class="filter-chips" role="group" aria-label="时间线分类筛选">
                    {filterNav.map((item) => (
                        <a class:list={['filter-chip', { 'is-active': item.active }]} href={item.href} aria-current={item.active ? 'page' : undefined}>
                            {item.label} <span>{item.count}</span>
                        </a>
                    ))}
                </div>
            ) : (
                <div class="filter-chips" role="group" aria-label="时间线筛选">
                    <a class:list={['filter-chip', { 'is-active': activeKind === 'all' }]} href={filterHref('all')} aria-current={activeKind === 'all' ? 'page' : undefined}>全部 <span data-count="all" data-total={timelineTotals.all}>{timelineTotals.all}</span></a>
                    <a class:list={['filter-chip', { 'is-active': activeKind === 'post' }]} href={filterHref('post')} aria-current={activeKind === 'post' ? 'page' : undefined}>文章 <span data-count="post" data-total={timelineTotals.post}>{timelineTotals.post}</span></a>
                    <a class:list={['filter-chip', { 'is-active': activeKind === 'memo' }]} href={filterHref('memo')} aria-current={activeKind === 'memo' ? 'page' : undefined}>随记 <span data-count="memo" data-total={timelineTotals.memo}>{timelineTotals.memo}</span></a>
                    {TIMELINE_INCLUDE_NEODB && (
                        <a class:list={['filter-chip', { 'is-active': activeKind === 'neodb' }]} href={filterHref('neodb')} aria-current={activeKind === 'neodb' ? 'page' : undefined}>书影音 <span data-count="neodb" data-total={timelineTotals.neodb}>{timelineTotals.neodb}</span></a>
                    )}
                    <a class:list={['filter-chip', { 'is-active': activeKind === 'strava' }]} href={filterHref('strava')} aria-current={activeKind === 'strava' ? 'page' : undefined}>运动 <span data-count="strava" data-total={timelineTotals.strava}>{timelineTotals.strava}</span></a>
                    <a class:list={['filter-chip', { 'is-active': activeKind === 'reading' }]} href={filterHref('reading')} aria-current={activeKind === 'reading' ? 'page' : undefined}>阅读与影视 <span data-count="reading+media" data-total={readingMediaTotal}>{readingMediaTotal}</span></a>
                </div>
            )}
            <p class="timeline-count" data-timeline-count data-active-kind={activeKind} aria-live="polite">
                共 {filterNav ? (filterNav.find((item) => item.active)?.count ?? filterNav[0]?.count ?? 0) : (activeKind === 'all' ? timelineTotals.all : activeKind === 'reading' ? readingMediaTotal : timelineTotals[activeKind as keyof typeof timelineTotals])} 条
            </p>
        </div>
        )}

        {groupBy === 'month' ? (
            <TimelineMonthList entries={entries} page={page} category={monthCategory} autoLoad={autoLoad} />
        ) : (
            <div class="tl tl-ledger timeline-list" data-timeline-list data-auto-load={autoLoad ? 'true' : 'false'} data-next={page.url?.next ?? ''}>
        {entries.map((entry, index) => {
            if (stravaGroupMembers.has(index) || neodbGroupMembers.has(index) || mediaGroupMembers.has(index)) return null;
            const showDate = index === 0 || dateKey(entries[index - 1].time) !== dateKey(entry.time);
            const stravaGroup = stravaGroupLeads.get(index) ?? null;
            const neodbGroup = neodbGroupLeads.get(index) ?? null;
            const mediaGroup = mediaGroupLeads.get(index) ?? null;
            const mediaCards = entry.kind === 'media' ? mediaCardsOf(mediaGroup ?? [entry]) : null;

            return (
                <article class:list={['ledger-row', { 'is-repeat': !showDate }]} data-kind={entry.kind} data-date-key={dateKey(entry.time)}>
                    <div class="ledger-date">
                        {cnDateParts(entry.time).year !== currentYear && <span class="ledger-year">{cnDateParts(entry.time).year}</span>}
                        <time class="ledger-date-value" datetime={dateKey(entry.time)}>{dayLabel(entry.time)}</time>
                        <span class="ledger-weekday">{weekday(entry.time)}</span>
                    </div>

                    <div class="ledger-rail" aria-hidden="true">
                        <span class="rail-marker">
                            {entry.kind === 'post' && <BookOpenText />}
                            {entry.kind === 'memo' && <MessageCircle />}
                            {entry.kind === 'neodb' && (neodbGroup ? <LibraryBig /> : <NeodbCategoryIcon category={entry.data.item.category} />)}
                            {entry.kind === 'strava' && <Footprints />}
                            {/* 阅读用书+心形，和文章的 BookOpenText 区分开 */}
                            {entry.kind === 'reading' && <BookHeart />}
                            {entry.kind === 'media' && <Clapperboard />}
                        </span>
                    </div>

                    <div class="ledger-body">
                        <div class="ledger-content">
                            {entry.kind === 'memo' && <LedgerMemo memo={entry.data} />}

                            {entry.kind === 'post' && (
                                <article class="ledger-post timeline-post-card">
                                    <div class="timeline-post-content">
                                        <h2 class="book-title">
                                            <a href={normalizeSlug(entry.data.slug)}>{entry.data.title}</a>
                                        </h2>
                                        <PostMeta post={entry.data} />
                                        {excerptText(entry.data.excerpt) && (
                                            <p>{excerptText(entry.data.excerpt)}</p>
                                        )}
                                    </div>
                                </article>
                            )}

                            {neodbGroup ? (
                                <div class="neodb-cards">
                                    {neodbGroup.map((groupEntry) => (
                                        <LedgerNeodb mark={groupEntry.data} />
                                    ))}
                                </div>
                            ) : (
                                entry.kind === 'neodb' && (
                                    <div class="neodb-cards">
                                        <LedgerNeodb mark={entry.data} />
                                    </div>
                                )
                            )}
                            {entry.kind === 'reading' && (
                                <div class="neodb-cards reading-cards">
                                    {entry.data.books.slice(0, 10).map((book: ReadingDayBook, bookIndex: number) => (
                                        <LedgerReading book={book} date={entry.data.date} index={bookIndex} coverUrl={book.cover ? coverByKey.get(book.cover) ?? null : null} />
                                    ))}
                                </div>
                            )}
                            {entry.kind === 'reading' && entry.data.books.length > 10 && (
                                <p class="reading-more">还有 {entry.data.books.length - 10} 本</p>
                            )}
                            {entry.kind === 'media' && mediaCards && (
                                <div class="neodb-cards reading-cards emby-cards">
                                    {mediaCards.map((card) =>
                                        card.kind === 'group' ? (
                                            <LedgerEmbyGroup entries={card.entries.map((item) => item.data)} coverUrl={mediaCoverById.get(card.entries[0].data.id) ?? null} />
                                        ) : (
                                            <LedgerEmby entry={card.entry.data} coverUrl={mediaCoverById.get(card.entry.data.id) ?? null} />
                                        )
                                    )}
                                </div>
                            )}
                            {stravaGroup ? (
                                <div class="strava-cards is-group">
                                    {stravaGroup.map((groupEntry) => (
                                        <LedgerStrava activity={groupEntry.data} metricIcons sketchMaxPoints={32} />
                                    ))}
                                </div>
                            ) : (
                                entry.kind === 'strava' && <LedgerStrava activity={entry.data} metricIcons sketchMaxPoints={32} />
                            )}
                        </div>

                        <div class="card-foot">
                            {entry.kind === 'reading' ? (
                                /* 阅读只有自然日 + 当日累计秒数（modureader 的 time 记录无时刻），不伪造 00:00 */
                                <time
                                    class="card-time"
                                    datetime={entry.data.date}
                                    title={`${entry.data.date} 当天累计阅读，数据只有日期没有具体时刻`}
                                >
                                    {entry.data.date} 全天
                                </time>
                            ) : (
                                <time class="card-time" datetime={new Date(entry.time).toISOString()} title={fullDate(entry.time)}>
                                    {fullDate(entry.time)}
                                </time>
                            )}
                        </div>
                    </div>
                </article>
            );
        })}
        </div>
        )}
        <p class="timeline-empty" data-timeline-empty hidden>没有符合条件的记录。</p>
    </>
) : (
    <div class="post-list">
        {entries.map((entry) => {
            const post = entry.data as PostItem;
            const excerpt = (post.excerpt ?? '').replace(/<[^>]+>/g, '').trim();
            return (
                <article class="markdown book-post">
                    <h2 class="book-title">
                        <a href={normalizeSlug(post.slug)}>{post.title}</a>
                    </h2>
                    <PostMeta post={post} />
                    {excerpt && <p>{excerpt.substring(0, 150)}{excerpt.length > 150 ? '…' : ''}</p>}
                </article>
            );
        })}
    </div>
)}


<script>
    import { onPageLoad } from '../../lib/client/mount';
    import { initTimeline } from '../../lib/client/timeline';
    import { initReadingTips } from '../../lib/client/reading-tips';
    import { initReadingTruncation } from '../../lib/client/reading-truncation';
    import { initEmbyGroups } from '../../lib/client/emby-group';

    onPageLoad(initTimeline);
    onPageLoad(initReadingTips);
    onPageLoad(initReadingTruncation);
    onPageLoad(initEmbyGroups);
</script>

