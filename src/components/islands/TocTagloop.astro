---
import { tags } from '../../api/store';
import { normalizeSlug } from '../../lib/utils/help';
import type { Tag } from '@ts-ghost/content-api';
---

<nav>
    <ul>
        <li class="book-section-flat">
            <strong>Tags</strong>
            <ul>
                {
                    tags
                        .filter((item: Tag) => item.visibility === 'public' && (item.count?.posts ?? 0) >= 3)
                        .sort((a: Tag, b: Tag) => (b.count?.posts ?? 0) - (a.count?.posts ?? 0))
                        .slice(0, 15)
                        .map((item: Tag) => (
                            <li class="flex justify-between">
                                <a href={`/tag${normalizeSlug(item.slug)}`}>#{item.name}</a>
                                <span>{item.count?.posts ?? 0}</span>
                            </li>
                        ))
                }
                <li class="flex justify-between">
                    <a href="/tags/" class="text-sm text-blue-600 hover:text-blue-800 underline">#More..</a>
                    <span>→</span>
                </li>
            </ul>
        </li>
    </ul>
</nav>
