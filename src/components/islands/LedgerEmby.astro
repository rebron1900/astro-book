---
/**
 * 时间线「影视」卡片（Emby）：复用阅读卡的几何与视觉，只换语义。
 *
 * 顶部行：片长（电影=全片，剧集=该集）；右侧是状态角标（看过 / 看到 42% / 刚开始）。
 * 标题行：电影=片名 + 「2024 · 剧情」；剧集=剧名 + 「S02E05 · 集名」。
 * 简介两行钳制（.reading-desc），截断才挂 tippy——直接复用 reading-truncation，不另写。
 * 底部轨道 4px、上下各 8.8px；气泡挂轨道下方、中心对准填充末端，规则与阅读卡一致。
 * 状态判定集中在 src/lib/emby.ts 的 embyCardState()。
 */
import { embyCardState, type EmbyEntry } from '../../lib/emby';
import { progressTier } from '../../lib/reading';

interface Props {
    entry: EmbyEntry;
    coverUrl?: string | null;
}

const { entry, coverUrl = null } = Astro.props;
const watch = embyCardState(entry);
const tier = progressTier(watch.barPercent);
const duration = entry.minutes === null ? '' : `${entry.minutes} 分钟`;
const subtitle =
    entry.type === 'episode'
        ? [entry.episodeCode, entry.episodeTitle].filter(Boolean).join(' · ')
        : entry.meta ?? '';
const stateLabel = `${entry.title}，${watch.label}${watch.bubble ? `（${watch.bubble}）` : ''}`;
---

<div class="reading-card neodb-card emby-card" data-emby-state={watch.state}>
    <div class="cover">
        {coverUrl ? <img src={coverUrl} alt={`${entry.title}封面`} loading="lazy" decoding="async" /> : <span aria-hidden="true">{entry.title.slice(0, 1)}</span>}
    </div>
    <div class="media-info">
        <div class="reading-head">
            <p class="reading-stats">
                {duration && (
                    <span class="rd-stat rd-stat-duration">
                        <strong>{entry.minutes}</strong>
                        <span class="rd-unit">分钟</span>
                    </span>
                )}
            </p>
            <span class="emby-status">{watch.label}</span>
        </div>
        <h2 class="reading-titleline">
            <span class="entry-title" title={entry.title}>{entry.title}</span>
            {subtitle && <span class="reading-author emby-sub" title={subtitle}>{subtitle}</span>}
        </h2>
        {entry.overview && <p class="reading-desc">{entry.overview}</p>}
    </div>
    <div class="rd-progress" role="img" aria-label={stateLabel} title={stateLabel} data-tier={tier} style={`--p: ${watch.barPercent}%`}>
        <span class="rd-progress-fill" style={`inline-size: ${watch.barPercent}%`}></span>
        {watch.bubble && <span class="rd-progress-badge" aria-hidden="true">{watch.bubble}</span>}
    </div>
</div>
