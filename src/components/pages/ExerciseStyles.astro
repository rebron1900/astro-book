<style is:global>
    /* ==========================================================================
       运动页面 /strava 专用样式（全局，`ex-` 前缀）
       结构：中间 = 页头 + 预览地图（吸顶）+ 时间线；右侧 = 运动统计
       ========================================================================== */

    /* ---------- 布局：右侧栏沿用主题标准宽度（16rem），只让内容可滚动 ---------- */
    body:has(.exercise-page) .book-toc .book-toc-content {
        overflow-y: auto;
        overflow-x: hidden;
        scrollbar-width: thin;
    }

    /* 移动端 TOC 抽屉里的统计（主题标准的 h-toc 位置） */
    .ex-mobile-toc {
        padding: 0.5rem 0.75rem 1rem;
    }

    .exercise-page {
        max-inline-size: none;
        inline-size: 100%;
    }

    /* ---------- 页头 ---------- */
    .ex-hero {
        margin: 0 0 1.75rem;
    }

    .ex-kicker {
        margin: 0;
        color: var(--color-link);
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .ex-title {
        margin: 0.4rem 0 0;
        font-size: clamp(1.5rem, 2.4vw, 1.85rem);
        font-weight: 600;
        line-height: 1.32;
        letter-spacing: -0.022em;
    }

    .ex-intro {
        max-inline-size: 40rem;
        margin: 0.65rem 0 0;
        color: var(--gray-700);
        font-size: 0.875rem;
        line-height: 1.85;
    }

    /* ---------- 预览地图：中间区顶部 + 滚动吸顶 ---------- */
    .ex-main {
        position: relative;
        min-inline-size: 0;
    }

    .ex-map-sentinel {
        block-size: 1px;
        margin-block-end: -1px;
    }

    .ex-map-hero {
        position: sticky;
        inset-block-start: 0;
        /* 高于时间线卡片（卡片是 position:relative），低于移动端抽屉菜单（见下方覆盖） */
        z-index: 30;
        margin-block-end: 1.6rem;
        padding-block: 0;
        background: transparent;
    }

    /* 悬浮时地图贴边：不要内边距和白色底，否则底部会多出一条空白 */
    .ex-map-hero.is-stuck {
        padding-block: 0;
        border: 1px solid color-mix(in srgb, var(--gray-500) 45%, transparent);
        border-radius: 0.6rem;
        background: var(--body-background);
        box-shadow: 0 10px 26px rgb(0 0 0 / 0.12);
        overflow: hidden;
    }

    .ex-map-hero.is-stuck .ex-map-card {
        border: 0;
        border-radius: 0;
        /* 阴影由外层 hero 统一给出，卡片本身不再投一层，避免压在筛选器上 */
        box-shadow: none;
    }

    .ex-map-card {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--gray-200);
        border-radius: 0.5rem;
        background: var(--gray-100);
        transition:
            border-radius 260ms ease,
            box-shadow 260ms ease;
    }

    /* 吸顶只改外层窗口高度并裁切画面，地图容器保持完整高度、按中线位移：
       这样切换时地图不会重新 resize / 取景，也就没有「先放大再缩回」的缩放跳变。 */
    .ex-map-viewport {
        --ex-map-full: 21rem;
        --ex-map-stuck: 15rem;
        position: relative;
        overflow: hidden;
        block-size: var(--ex-map-full);
        transition: block-size 300ms cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    .ex-map-hero.is-stuck .ex-map-viewport {
        block-size: var(--ex-map-stuck);
    }

    .ex-map-canvas {
        inline-size: 100%;
        block-size: var(--ex-map-full);
        background: var(--gray-100);
        transition: transform 300ms cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    .ex-map-hero.is-stuck .ex-map-canvas {
        transform: translateY(calc((var(--ex-map-stuck) - var(--ex-map-full)) / 2));
    }

    /* 窗口尺寸变化（含横竖屏切换）会跨断点改高度：直接切到新尺寸，不播放裁切动画 */
    .ex-map-hero.is-resizing .ex-map-viewport,
    .ex-map-hero.is-resizing .ex-map-canvas {
        transition: none;
    }

    .ex-map-badge {
        position: absolute;
        z-index: 2;
        inset-block-start: 0.45rem;
        inset-inline-start: 0.45rem;
        max-inline-size: calc(100% - 0.9rem);
        overflow: hidden;
        padding: 0.14rem 0.5rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--body-background) 86%, transparent);
        color: var(--body-font-color);
        font-size: 0.6875rem;
        line-height: 1.5;
        text-overflow: ellipsis;
        white-space: nowrap;
        backdrop-filter: blur(6px);
        pointer-events: none;
    }

    .ex-map-reset {
        position: absolute;
        z-index: 2;
        inset-block-start: 0.45rem;
        inset-inline-end: 0.45rem;
        padding: 0.14rem 0.45rem;
        border: 1px solid var(--gray-200);
        border-radius: 999px;
        background: color-mix(in srgb, var(--body-background) 86%, transparent);
        color: var(--gray-700);
        font-size: 0.6875rem;
        line-height: 1.5;
        cursor: pointer;
        backdrop-filter: blur(6px);
    }

    .ex-map-reset:hover {
        color: var(--color-link);
        border-color: color-mix(in srgb, var(--color-link) 45%, var(--gray-200));
    }

    /* 提示条放在角标 /「全部」按钮下面一行：顶到同一行时窄屏会压住日期角标 */
    .ex-map-state {
        position: absolute;
        z-index: 2;
        inset-block-start: 2.4rem;
        inset-inline-start: 50%;
        max-inline-size: calc(100% - 1.4rem);
        overflow: hidden;
        margin: 0;
        padding: 0.18rem 0.55rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--body-background) 82%, transparent);
        color: var(--gray-700);
        font-size: 0.625rem;
        line-height: 1.5;
        text-align: center;
        text-overflow: ellipsis;
        white-space: nowrap;
        backdrop-filter: blur(6px);
        transform: translateX(-50%);
    }

    .ex-map-state[hidden] {
        display: none;
    }

    /* ---------- 右侧统计 ---------- */
    .ex-sidebar {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        min-inline-size: 0;
    }

    .ex-stats-stack {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        min-inline-size: 0;
    }

    .ex-stats-divider {
        margin: 0.1rem 0;
        border: 0;
        border-block-start: 1px solid var(--gray-200);
    }

    .ex-stats-card {
        min-inline-size: 0;
        padding: 0;
        border: 0;
        border-radius: 0.5rem;
        background: transparent;
    }

    .ex-tabs {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.1rem;
        padding: 0.12rem;
        border-radius: 0.375rem;
        background: var(--gray-100);
    }

    .ex-tab {
        appearance: none;
        padding: 0.26rem 0;
        border: 0;
        border-radius: 0.3rem;
        background: transparent;
        color: var(--gray-700);
        font: inherit;
        font-size: 0.6875rem;
        line-height: 1.4;
        text-align: center;
        cursor: pointer;
        transition:
            background 140ms ease,
            color 140ms ease;
    }

    .ex-tab:hover {
        color: var(--body-font-color);
    }

    .ex-tab.is-active {
        background: var(--body-background);
        color: var(--body-font-color);
        font-weight: 600;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
    }

    .ex-tab:focus-visible {
        outline: 2px solid var(--color-link);
        outline-offset: 1px;
    }

    .ex-tab-panel {
        padding-block-start: 0.55rem;
    }

    /* ---------- 地图下方：运动类型筛选（跟着地图一起吸顶，复用首页 filter-chip 样式） ---------- */
    .ex-map-filter {
        margin-block-start: 0.55rem;
        padding-inline: 0.55rem;
    }

    /* 吸顶后筛选器成为地图浮层的一部分：和地图共用白底，用一条细线区分 */
    .ex-map-hero.is-stuck .ex-map-filter {
        margin-block-start: 0;
        padding-block: 0.42rem 0.5rem;
        border-block-start: 1px solid color-mix(in srgb, var(--gray-500) 24%, transparent);
        background: var(--body-background);
    }

    /* 重播进度：贴着地图底边的窄条，左边暂停 / 右边关闭，中间是可拖动的小圆球 */
    .ex-map-replay-bar {
        position: absolute;
        z-index: 3;
        inset-inline: 0;
        inset-block-end: 0;
        display: flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.42rem 0.45rem 0.38rem;
        background: linear-gradient(to top, color-mix(in srgb, var(--body-background) 84%, transparent), transparent);
        pointer-events: auto;
    }

    /* 重播时底部的运动信息卡让位给进度条 */
    .ex-map-card.is-replaying .ex-map-info {
        opacity: 0;
        visibility: hidden;
    }

    .ex-map-card .ex-map-info {
        transition:
            opacity 160ms ease,
            visibility 160ms ease;
    }

    .ex-map-replay-control {
        display: grid;
        flex: none;
        place-items: center;
        inline-size: 1.3rem;
        block-size: 1.3rem;
        padding: 0;
        border: 1px solid color-mix(in srgb, var(--body-font-color) 18%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--body-background) 82%, transparent);
        color: var(--body-font-color);
        box-shadow: 0 1px 4px rgb(0 0 0 / 0.18);
        cursor: pointer;
        backdrop-filter: blur(6px);
        transition:
            background 140ms ease,
            color 140ms ease,
            border-color 140ms ease;
    }

    .ex-map-replay-control:hover {
        border-color: color-mix(in srgb, var(--color-link) 55%, transparent);
        color: var(--color-link);
    }

    .ex-map-replay-control:focus-visible {
        outline: 2px solid var(--color-link);
        outline-offset: 1px;
    }

    .ex-map-replay-close {
        color: var(--gray-500);
    }

    .ex-map-replay-icon {
        inline-size: 0.7rem;
        block-size: 0.7rem;
    }

    .ex-map-replay-range {
        flex: 1 1 auto;
        min-inline-size: 0;
        block-size: 1.1rem;
        margin: 0;
        padding: 0;
        appearance: none;
        -webkit-appearance: none;
        background: transparent;
        cursor: pointer;
    }

    .ex-map-replay-range::-webkit-slider-runnable-track {
        height: 2px;
        border-radius: 999px;
        background: linear-gradient(
            to right,
            var(--color-link) 0 var(--ex-replay-progress, 0%),
            color-mix(in srgb, var(--body-font-color) 26%, transparent) var(--ex-replay-progress, 0%) 100%
        );
    }

    .ex-map-replay-range::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 0.7rem;
        height: 0.7rem;
        margin-top: calc((2px - 0.7rem) / 2);
        border: 2px solid var(--color-link);
        border-radius: 50%;
        background: var(--body-background);
        box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    }

    .ex-map-replay-range::-moz-range-track {
        height: 2px;
        border: 0;
        border-radius: 999px;
        background: linear-gradient(
            to right,
            var(--color-link) 0 var(--ex-replay-progress, 0%),
            color-mix(in srgb, var(--body-font-color) 26%, transparent) var(--ex-replay-progress, 0%) 100%
        );
    }

    .ex-map-replay-range::-moz-range-thumb {
        width: 0.7rem;
        height: 0.7rem;
        border: 2px solid var(--color-link);
        border-radius: 50%;
        background: var(--body-background);
        box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    }

    .filter-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        min-inline-size: 0;
    }

    .filter-chip {
        display: inline-flex;
        align-items: baseline;
        gap: 0.3rem;
        margin: 0;
        padding: 0.3rem 0.7rem;
        border: 1px solid var(--gray-200);
        border-radius: 999px;
        background: transparent;
        color: var(--gray-700);
        font: inherit;
        font-size: 0.75rem;
        line-height: 1.25;
        text-decoration: none;
        cursor: pointer;
        transition:
            background-color 140ms ease,
            border-color 140ms ease,
            color 140ms ease;
    }

    .filter-chip span {
        color: var(--gray-500);
        font-size: 0.625rem;
        font-variant-numeric: tabular-nums;
    }

    .filter-chip:hover {
        border-color: var(--gray-400);
        color: var(--body-font-color);
    }

    .filter-chip.is-active {
        border-color: var(--body-font-color);
        background: var(--body-font-color);
        color: var(--body-background);
    }

    .filter-chip.is-active span {
        color: color-mix(in srgb, var(--body-background) 65%, transparent);
    }

    /* ---------- 时间线：沿用首页 ledger 结构 ---------- */
    .ex-timeline [hidden] {
        display: none !important;
    }

    .ex-timeline.timeline-list {
        inline-size: 100%;
        margin-block: 0.5rem 1.5rem;
    }

    .ex-timeline .ledger-row {
        position: relative;
        --ledger-row-gap: 1.7rem;
        display: grid;
        grid-template-columns: 3rem minmax(0, 1fr);
        grid-template-rows: auto auto;
        column-gap: 0.55rem;
        row-gap: 0;
        align-items: start;
        min-inline-size: 0;
    }

    .ex-timeline .ledger-row + .ledger-row {
        margin-block-start: var(--ledger-row-gap);
    }

    /* 每行只在日期与图标之间的空隙画线，避免竖线穿过文字和 SVG。 */
    .ex-timeline .ledger-row + .ledger-row::before {
        content: '';
        position: absolute;
        z-index: 0;
        inset-block-start: calc(-1 * var(--ledger-row-gap));
        inset-inline-start: calc(1.5rem - 0.5px);
        block-size: var(--ledger-row-gap);
        inline-size: 1px;
        background: var(--gray-200);
        pointer-events: none;
    }

    .ex-timeline .ledger-date {
        position: relative;
        display: flex;
        grid-column: 1;
        grid-row: 1;
        flex-direction: column;
        align-items: center;
        justify-self: center;
        gap: 0.08rem;
        z-index: 2;
        padding: 0 0.1rem 0.35rem;
        color: var(--gray-700);
        font-variant-numeric: tabular-nums;
        text-align: center;
        cursor: pointer;
    }

    .ex-timeline .ledger-date .ledger-year {
        color: var(--gray-500);
        font-size: 0.5625rem;
        line-height: 1.15;
    }

    .ex-timeline .ledger-date .ledger-date-value {
        color: var(--body-font-color);
        font-size: 0.8125rem;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.01em;
    }

    .ex-timeline .ledger-date .ledger-weekday {
        color: var(--gray-500);
        font-size: 0.625rem;
        line-height: 1.2;
    }

    .ex-timeline .ledger-row.is-active .ledger-date-value {
        color: var(--color-link);
    }

    .ex-timeline .ledger-rail {
        position: relative;
        display: flex;
        grid-column: 1;
        grid-row: 2;
        align-self: stretch;
        justify-content: center;
    }

    .ex-timeline .ledger-rail::before {
        content: '';
        position: absolute;
        z-index: 0;
        inset-block: 0.95rem 0;
        inset-inline-start: calc(1.5rem - 0.5px);
        inline-size: 1px;
        background: var(--gray-200);
        pointer-events: none;
    }

    .ex-timeline .rail-marker {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        inline-size: 0.95rem;
        block-size: 0.95rem;
        color: color-mix(in srgb, #18794e 55%, var(--gray-500));
    }

    .ex-timeline .rail-marker::before {
        content: '';
        position: absolute;
        z-index: -1;
        inset-block: 0;
        inset-inline-start: 50%;
        inline-size: 3px;
        background: var(--body-background);
        transform: translateX(-50%);
    }

    .ex-timeline .rail-marker svg {
        position: relative;
        z-index: 1;
        inline-size: 0.78rem;
        block-size: 0.78rem;
        stroke-width: 2;
        overflow: visible;
    }

    .ex-timeline .ledger-row.is-active .rail-marker {
        color: var(--color-link);
    }

    .ex-timeline .ledger-body {
        grid-column: 2;
        grid-row: 2;
        min-inline-size: 0;
    }

    .ex-timeline .ledger-content {
        min-inline-size: 0;
    }

    /* ---------- 运动卡片：完全沿用首页 StravaCardPreview 的结构 ---------- */
    .ex-timeline .strava-cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
        gap: 0.8rem;
    }

    .ex-timeline .strava-card {
        --strava-color: #16a34a;
        position: relative;
        overflow: hidden;
        padding: 0.8rem 0.9rem 0.85rem;
        border-radius: 0.375rem;
        background: color-mix(in srgb, var(--body-background) 92%, var(--strava-color));
        box-shadow: inset 0 0 0 1px var(--gray-200);
        cursor: pointer;
        transition:
            transform 160ms ease,
            box-shadow 160ms ease;
    }

    /* 和首页时间线相同的入场方式：月份行进入视口时，卡片区域一起淡入上浮 */
    @media (prefers-reduced-motion: no-preference) {
        .ex-timeline .ex-month-row.reveal-ready .ledger-body {
            opacity: 0.45;
            transform: translateY(14px);
        }

        .ex-timeline .ex-month-row.reveal-ready.is-visible .ledger-body {
            opacity: 1;
            transform: translateY(0);
            transition:
                opacity 520ms ease-out,
                transform 620ms cubic-bezier(0.2, 0.6, 0.2, 1);
        }
    }

    .ex-timeline .strava-card.sport-ride {
        --strava-color: #2563eb;
    }

    .ex-timeline .strava-card.sport-walk {
        --strava-color: #b45309;
    }

    .ex-timeline .strava-card.sport-hike {
        --strava-color: #4d7c0f;
    }

    .ex-timeline .strava-card.sport-climb {
        --strava-color: #7c3aed;
    }

    .ex-timeline .strava-card.sport-swim {
        --strava-color: #0e7490;
    }

    .ex-timeline .strava-card.sport-other {
        --strava-color: var(--gray-500);
    }

    .ex-timeline .strava-card:hover,
    .ex-timeline .strava-card:focus-within {
        transform: translateY(-1px);
        box-shadow:
            inset 0 0 0 1px color-mix(in srgb, var(--color-link) 30%, var(--gray-200)),
            0 5px 18px rgb(0 0 0 / 0.06);
    }

    .ex-timeline .strava-card.is-active {
        box-shadow: inset 0 0 0 1.5px var(--color-link);
    }

    .ex-timeline .strava-route {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        inline-size: 100%;
        block-size: 100%;
        color: var(--strava-color);
        opacity: 0.2;
        pointer-events: none;
        mask-image: linear-gradient(to bottom, #000 48%, transparent 100%);
        -webkit-mask-image: linear-gradient(to bottom, #000 48%, transparent 100%);
    }

    .ex-timeline .strava-route path {
        fill: none;
        stroke: currentColor;
        stroke-width: 2.4;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .ex-timeline .strava-route circle {
        fill: currentColor;
    }

    .ex-timeline .strava-content {
        position: relative;
        z-index: 1;
    }

    .ex-timeline .strava-title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem;
    }

    .ex-timeline .strava-title-row .entry-title {
        margin: 0;
    }

    .ex-timeline .strava-sport-icon {
        flex: none;
        inline-size: 0.9rem;
        block-size: 0.9rem;
        color: var(--strava-color);
    }

    .ex-timeline .strava-sport-name {
        color: var(--strava-color);
        font-size: 0.6875rem;
        font-weight: 600;
    }

    .ex-timeline .strava-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 0.9rem;
        row-gap: 0.4rem;
        margin-block: 0.6rem 0;
    }

    .ex-timeline .strava-stats > div {
        display: flex;
        align-items: baseline;
        gap: 0.3rem;
        min-inline-size: 0;
    }

    .ex-timeline .strava-stats dt {
        color: var(--gray-500);
        font-size: 0.6875rem;
        white-space: nowrap;
    }

    .ex-timeline .strava-stats dd {
        margin: 0;
        color: var(--body-font-color);
        font-size: 0.78rem;
        font-weight: 600;
        white-space: nowrap;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    .ex-timeline .strava-stats .is-primary dd {
        color: var(--strava-color);
    }

    /* 320px 级别的窄屏：两列统计收紧列间距与数值字号，标签不折行 */
    @media screen and (max-width: 22rem) {
        .ex-timeline .strava-stats {
            column-gap: 0.35rem;
        }

        .ex-timeline .strava-stats dd {
            font-size: 0.72rem;
        }
    }

    .ex-timeline .entry-title {
        margin: 0;
