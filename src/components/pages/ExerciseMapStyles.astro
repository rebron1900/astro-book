---
/**
 * 运动页地图卡片的内部样式（Mapbox GL 产出 DOM 的细节）。
 * 卡片骨架（尺寸 / 角标 / 「全部」按钮 / 提示条）在 ExerciseStyles.astro 里，
 * 这里只补 `ex-map-` 前缀下的地图内部细节，全部走全局样式。
 */
---

<style is:global>
    /* ---------- 地图容器 ---------- */
    .ex-map-canvas {
        position: relative;
    }

    .ex-map-canvas.mapboxgl-map {
        background: var(--gray-100);
    }

    .ex-map-canvas .mapboxgl-canvas {
        outline: none;
    }

    .ex-map-canvas .mapboxgl-canvas:focus-visible {
        outline: 2px solid var(--color-link);
        outline-offset: -2px;
    }

    /* ---------- 卡片上的两个浮层控件 ---------- */
    /* 「全部」按钮在深浅色主题下都要读得出是按钮，而不是一个暗色噪点 */
    .ex-map-card .ex-map-reset {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-block-size: 1.4rem;
        padding: 0.1rem 0.55rem;
        border: 1px solid color-mix(in srgb, var(--body-font-color) 22%, transparent);
        background: color-mix(in srgb, var(--body-background) 94%, transparent);
        color: var(--body-font-color);
        font-size: 0.6875rem;
        font-weight: 600;
        line-height: 1.4;
        box-shadow: 0 1px 3px rgb(0 0 0 / 0.14);
    }

    .ex-map-card .ex-map-reset:hover {
        border-color: color-mix(in srgb, var(--color-link) 60%, transparent);
        color: var(--color-link);
    }

    /* 单条轨迹的重播按钮：右下角，圆形，和角标 /「全部」同一层玻璃质感 */
    .ex-map-card .ex-map-play {
        position: absolute;
        z-index: 2;
        inset-block-end: 0.5rem;
        inset-inline-end: 0.5rem;
        display: grid;
        place-items: center;
        inline-size: 1.75rem;
        block-size: 1.75rem;
        padding: 0;
        border: 1px solid color-mix(in srgb, var(--body-font-color) 20%, transparent);
        border-radius: 999px;
        background: color-mix(in srgb, var(--body-background) 88%, transparent);
        color: var(--body-font-color);
        box-shadow: 0 2px 8px rgb(0 0 0 / 0.18);
        cursor: pointer;
        backdrop-filter: blur(8px) saturate(1.1);
        transition:
            color 140ms ease,
            border-color 140ms ease,
            background 140ms ease,
            transform 140ms ease;
    }

    .ex-map-card .ex-map-play:hover {
        border-color: color-mix(in srgb, var(--color-link) 60%, transparent);
        color: var(--color-link);
    }

    .ex-map-card .ex-map-play:active {
        transform: scale(0.92);
    }

    .ex-map-card .ex-map-play:focus-visible {
        outline: 2px solid var(--color-link);
        outline-offset: 2px;
    }

    .ex-map-card .ex-map-play.is-playing {
        border-color: color-mix(in srgb, var(--color-link) 55%, transparent);
        background: color-mix(in srgb, var(--color-link) 12%, var(--body-background));
        color: var(--color-link);
    }

    .ex-map-play-icon {
        inline-size: 0.8rem;
        block-size: 0.8rem;
    }

    /* 第一视角重播时镜头自己在动，期间不让画布接管鼠标 / 触摸手势 */
    .ex-map-card.is-replaying .mapboxgl-canvas-container {
        pointer-events: none;
    }

    .ex-map-card.is-replaying {
        cursor: default;
    }

    .ex-map-card .ex-map-badge {
        font-size: 0.6563rem;
        font-weight: 500;
        box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
    }

    /* 手机上信息卡贴着底边，播放按钮抬到它上面一行 */
    @media screen and (max-width: 47.84rem) {
        .ex-map-card .ex-map-play {
            inset-block-end: 2.55rem;
        }
    }

    /* ---------- 控件：11.5rem 高的小卡片里尽量克制，但不隐藏版权信息 ---------- */
    .ex-map-canvas .mapboxgl-ctrl {
        margin: 0.25rem;
    }

    .ex-map-canvas .mapboxgl-ctrl-group {
        border-radius: 0.3rem;
    }

    .ex-map-canvas .mapboxgl-ctrl-attrib,
    .ex-map-canvas .mapboxgl-ctrl-attrib a {
        font-size: 0.5625rem;
        line-height: 1.4;
    }

    .ex-map-canvas .mapboxgl-ctrl-logo {
        margin: 0 0 0.3rem 0.3rem;
    }

    /* 底部提示条出现时把 logo / attribution 抬到提示条上方，避免被遮住 */
    .ex-map-canvas.has-state .mapboxgl-ctrl-bottom-left,
    .ex-map-canvas.has-state .mapboxgl-ctrl-bottom-right {
        margin-block-end: 1.5rem;
    }


    /* ---------- 单条路线的运动信息卡 ---------- */
    .ex-map-info {
        position: absolute;
        z-index: 2;
        inset-inline-start: 0.5rem;
        inset-block-end: 0.5rem;
        max-inline-size: 15rem;
        padding: 0.35rem 0.5rem 0.4rem;
        border-radius: 0.4rem;
        background: color-mix(in srgb, var(--body-background) 58%, transparent);
        box-shadow:
            0 2px 12px rgb(0 0 0 / 0.08),
            inset 0 0 0 1px color-mix(in srgb, var(--body-background) 42%, transparent);
        backdrop-filter: blur(8px) saturate(1.08);
        pointer-events: none;
    }

    .ex-map-info-top {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        color: var(--gray-500);
        font-size: 0.5625rem;
    }

    .ex-map-info-sport {
        color: var(--color-link);
        font-weight: 600;
    }

    .ex-map-info-name {
        overflow: hidden;
        margin: 0.1rem 0 0.25rem;
        color: var(--body-font-color);
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1.3;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ex-map-info-stats {
        display: flex;
        gap: 0.55rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .ex-map-info-stats li {
        display: flex;
        flex-direction: column;
        gap: 0.02rem;
    }

    .ex-map-info-stats b {
        color: var(--body-font-color);
        font-size: 0.625rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .ex-map-info-stats span {
        color: var(--gray-500);
        font-size: 0.5rem;
    }

    @media screen and (max-width: 47.84rem) {
        /* 手机上把信息卡摊成贴底的单行长条：名称 + 全部四项数据，一行放不下时名称省略，
           数据不省略；日期和运动类型由顶部角标负责，不在这里重复。 */
        .ex-map-info {
            inset-inline: 0.4rem;
            inset-block-end: 0.4rem;
            display: flex;
            align-items: baseline;
            gap: 0.45rem;
            max-inline-size: none;
            padding: 0.26rem 0.5rem 0.3rem;
            white-space: nowrap;
        }

        .ex-map-info-top {
            display: none;
        }

        .ex-map-info-name {
            flex: 1 1 auto;
            min-inline-size: 0;
            margin: 0;
            font-size: 0.6563rem;
            line-height: 1.4;
        }

        .ex-map-info-stats {
            flex: none;
            align-items: baseline;
            gap: 0.4rem;
        }

        .ex-map-info-stats li {
            flex-direction: row;
            align-items: baseline;
            gap: 0.14rem;
        }

        /* 较宽的移动端保留数值后的小标签；更窄时标签让位给名称（见下方） */
        .ex-map-info-stats b {
            font-size: 0.5938rem;
        }

        .ex-map-info-stats span {
            font-size: 0.5rem;
        }
    }

    /* 手机窄屏：标签让位给名称，四项数值（带单位）全部保留，用间隔点分隔 */
    @media screen and (max-width: 30rem) {
        .ex-map-info {
            gap: 0.35rem;
            padding-inline: 0.4rem;
        }

        .ex-map-info-stats {
            gap: 0.3rem;
        }

        .ex-map-info-stats li + li::before {
            content: '·';
            color: var(--gray-500);
            font-size: 0.5rem;
        }

        /* 标签视觉上收起（保留给读屏），把宽度让给名称 */
        .ex-map-info-stats span {
            position: absolute;
            overflow: hidden;
            inline-size: 1px;
            block-size: 1px;
            clip-path: inset(50%);
            white-space: nowrap;
        }
    }

    /* 360px 级别的窄屏再把数值压小一号，名称尽量完整 */
    @media screen and (max-width: 23.5rem) {
        .ex-map-info-stats b {
            font-size: 0.5625rem;
        }
    }

    /* 右下角的版权信息 / 左下角 logo 不显示 */
    .ex-map-canvas .mapboxgl-ctrl-logo,
    .ex-map-canvas .mapboxgl-ctrl-attrib {
        display: none !important;
    }

    /* 触屏上单指滑动滚页面时不再弹全屏黑色提示；双指手势本身就能拖动地图 */
    .ex-map-canvas .mapboxgl-touch-pan-blocker {
        display: none !important;
    }

    /* 拖拽平移时的抓手光标由 Mapbox 自己写在 canvas 的内联样式上，这里不用干预 */
</style>
