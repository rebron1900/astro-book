---
import { settings } from '../../api/store';
import { StickyNote, HouseHeart, MessageCircleHeart, Sparkles, Sprout, Images, TentTree, Package, Tags, Flower2, DoorOpen } from '@lucide/astro';

const { title } = Astro.props;

const EMOJI_SEQ = /(\p{RI}\p{RI}|\p{Emoji}(\p{Emoji_Modifier}|\u200D\p{Emoji})*)$/u;

const ICON_MAP: Record<string, typeof StickyNote> = {
    '📄': StickyNote,
    '🏠': HouseHeart,
    '🚩': MessageCircleHeart,
    '📖': Sparkles,
    '😎': Sprout, // ← 这里一定要“复制粘贴”
    '🚧': Images,
    '👣': TentTree,
    '🪴': Flower2,
    '📦': Package,
    '📌': Tags,
    '🧑‍🤝‍🧑': DoorOpen // 同样复制粘贴
};

const nav = settings?.navigation ?? [];

const menus = nav.map((rawItem) => {
    // 先准备返回骨架
    const node: { icon?: typeof StickyNote; item: typeof rawItem; cleanLabel?: string } = { item: rawItem };

    // 尝试摘 emoji
    const emojiMatch = rawItem.label.match(EMOJI_SEQ);
    if (emojiMatch) {
        const emoji = emojiMatch[1];
        const Comp = ICON_MAP[emoji];
        if (Comp) {
            node.icon = Comp; // 只在新结构里放图标
            node.cleanLabel = rawItem.label.replace(EMOJI_SEQ, '').trim();
        }
    }
    return node;
});

// 站内路径统一去掉首尾差异；支持二级页面（如 /timeline/memo/2/）命中父级菜单。
const normalizePath = (value: string) => {
    const path = value.split(/[?#]/, 1)[0];
    return path.replace(/\/+$/, '') || '/';
};
const isActiveUrl = (url: string) => {
    if (!url.startsWith('/')) return false;
    const current = normalizePath(Astro.url.pathname);
    const target = normalizePath(url);
    return current === target || (target !== '/' && current.startsWith(`${target}/`));
};
const hasActiveNav = menus.some(({ item }) => isActiveUrl(item.url));
---

<ul class="book-menu-nav">
    <li class="book-section-flat">
        <span>路线牌</span>

        <ul class="book-collspan">
            {
                title && !hasActiveNav && (
                    <li class="menu-flag-item">
                        <span class="menu-flag-marker" aria-hidden="true"></span>
                        {/* prettier-ignore */}
                        <a href="javascript:void(0)" class="menu-flag current ellipsis">
                            <StickyNote class="book-icon" />{title}
                        </a>
                    </li>
                )
            }

            {
                menus.map(({ icon: Icon, item, cleanLabel: CleanLabel }) => {
                    const isCurrent = isActiveUrl(item.url);
                    return (
                        <li class="menu-flag-item">
                            {isCurrent && <span class="menu-flag-marker" aria-hidden="true"></span>}
                            {/* prettier-ignore */}
                            <a href={item.url} class={`menu-flag ellipsis ${isCurrent ? 'current' : ''}`}>
                                {Icon && <Icon class="book-icon" />}{CleanLabel || item.label}
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </li>
</ul>
