---
import { TableOfContents } from '@lucide/astro';

const { title } = Astro.props;
---

<!--
    移动端悬浮顶栏：两颗圆按钮 + 中间一枚胶囊，都是磨砂玻璃。
    桌面端整块 display:none（见 .book-header），这里的结构只服务窄屏。
-->
<div class="bk-bar">
    <label class="bk-btn bk-btn-logo" for="menu-control" aria-label="打开菜单">
        <img src="/logo.svg" alt="" width="44" height="44" aria-hidden="true" />
    </label>

    <div class="bk-pill">
        <strong class="bk-title" title={title}>{title}</strong>
    </div>

    <label class="bk-btn" for="toc-control" aria-label="打开目录">
        <TableOfContents class="bk-icon" aria-hidden="true" />
    </label>
</div>

<script>
    // 磨砂玻璃只在能扛住的设备上开：模糊是每帧重算的像素开销，
    // 低端机（核心少 / 内存小）和系统「降低透明度」时直接退化成接近实心的表面。
    const root = document.documentElement;
    if (root.dataset.bkLite === undefined) {
        const cores = navigator.hardwareConcurrency ?? 8;
        const memory = (navigator as Navigator & { deviceMemory?: number }).deviceMemory ?? 8;
        const opaque = window.matchMedia('(prefers-reduced-transparency: reduce)').matches;
        root.dataset.bkLite = opaque || (cores <= 4 && memory <= 4) ? 'on' : 'off';
    }
</script>
