---
import type { MetricIconKind } from '../../lib/metric-icons';

/**
 * 指标小图标（Astro 版）：与 `MetricIcon.tsx`（Solid 版）共用 `src/lib/metric-icons.ts`
 * 里的同一份路径，保证构建期渲染的时间线卡片和浏览器端 island 长得一样。
 * 纯装饰，读屏由相邻的文字标签负责，所以固定 aria-hidden。
 *
 * 这里只输出一行 <use>，路径定义在 `MetricSprite.astro` 的 <symbol> 里（整页一份）：
 * 一张运动页有 1000 多个指标图标，内联路径会让 HTML 多出近 300KB。
 */
interface Props {
    kind: MetricIconKind;
    class?: string;
}

const { kind, class: className = 'metric-icon' } = Astro.props as Props;
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true"><use href={`#mi-${kind}`}></use></svg>
