---
import imageMeta from '../../data/image-meta.json';

export interface Props {
    src: string;
    alt?: string;
    class?: string;
    classNames?: string;
}
const encode = (s: string) => encodeURI(s);
type Size = { width: number; height: number };

// 方案 B：图片尺寸由 sync-data 预取到 src/data/image-meta.json，构建零网络
function getSize(raw: string | undefined): Size | undefined {
    if (!raw) return undefined; // 防御：外部 HTML 可能缺 src

    // 从本地预取的 meta 读取（key 格式：size_<url>）
    const cached = (imageMeta as unknown as Record<string, Size | undefined>)[`size_${raw}`];
    if (cached && cached.width && cached.height) {
        return cached;
    }

    // unsplash 可从 URL 参数推导
    if (raw.includes('unsplash.com')) {
        const url = new URL(raw);
        const w = Number(url.searchParams.get('w'));
        if (w) return { width: w, height: w * 2 };
    }

    return undefined;
}

const { src, alt, class: className, classNames, ...attrs } = Astro.props;
const resolvedClass = className ?? classNames;
// Memos 旧域名会 302 到对象存储；直接使用最终 CDN 地址，避免图片在部分网络下长时间卡住。
const mediaSrc = src
    .replace(/^https:\/\/social\.1900\.live\/fileserver\//, 'https://s3.996288.xyz/')
    .replace(/!\d+w$/, '');

const cdnUrl = import.meta.env.CDN_URL ?? '';
const generateImageSrcset = (image: string) => {
    image = encodeURI(image.replace(/!\d+w$/, ''));
    let imageSrcset = [];
    const imageWidths = [400, 600, 800, 1000, 1200, 1400, 1600, 1800];

    if (cdnUrl && image.startsWith(cdnUrl)) {
        // If image is local, determine the width of the image and then generate
        // markup for images at sizes smaller than the image
        imageWidths.forEach((width) => {
            let img = image.endsWith('.gif') == true ? image : `${image}!${width}w ${width}w`;
            imageSrcset.push(img);
        });
    } else if (image.match('unsplash.com')) {
        imageWidths.forEach((width) => {
            const updatedUrl = image.replace(/(w=)[^\&]+/, '$1' + width);
            imageSrcset.push(`${updatedUrl} ${width}w`);
        });
    } else {
        imageSrcset.push(image);
    }

    return imageSrcset.join(', ');
};

// 只处理 cdn.1900.live 的图片
const isCdn = mediaSrc && (mediaSrc.startsWith('https://cdn.1900.live/') || mediaSrc.match('unsplash.com')) ? true : false;
const size = getSize(mediaSrc);
---

{
    isCdn && size ? (
        <img
            loading="lazy"
            decoding="async"
            class={resolvedClass ?? ''}
            src={encodeURI(mediaSrc)}
            alt={alt ?? ''}
            {...attrs}
            srcset={generateImageSrcset(mediaSrc)}
            width={size.width}
            height={size.height}
        />
    ) : (
        <img loading="lazy" decoding="async" class={resolvedClass ?? ''} src={encodeURI(mediaSrc)} srcset={generateImageSrcset(mediaSrc)} alt={alt ?? ''} />
    )
}
