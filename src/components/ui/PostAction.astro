---
import { Heart } from '@lucide/astro';

import config from '../../config';

const { post } = Astro.props;
---

<div class="post_action flex flex-wrap justify-center">
    <div class="post_like" data-postid={post.id} data-apiurl={config.apiUrl}>
        <Heart class="book-icon" />

        <div class="post_like_desc">「 觉得本文不错？点个赞把！... 」</div>
    </div>
</div>

<script>
    import cocoMessage from '../../lib/coco-message';

    document.addEventListener('astro:page-load', () => {
        cocoMessage.insertCSS();
        const likeNode = document.querySelector<HTMLElement>('.post_like');
        if (likeNode) {
            const post_id = likeNode.dataset.postid ?? '';
            const apiUrl = likeNode.dataset.apiurl ?? '';

            const postAction = {
                like: (post_id: string, apiUrl: string) => {
                    var likelist = localStorage.getItem('lieklist') || '';
                    var likeButton = document.querySelector<HTMLElement>('.post_like');
                    var likeText = document.querySelector<HTMLElement>('.post_likes');

                    if (likelist.indexOf(post_id + ',') != -1) {
                        cocoMessage.success('你已经点过赞了 ❤️');
                        likeButton?.classList.add('active');
                    } else {
                        fetch(`${apiUrl}/action?type=like&post_id=${post_id}`, { method: 'post' })
                            .then((res) => {
                                return res.json();
                            })
                            .then((data: { likes: number }) => {
                                cocoMessage.success('点赞成功，谢谢你的 ❤️');
                                localStorage.setItem('lieklist', likelist + post_id + ',');
                                likeButton?.classList.add('active');
                                if (likeText) likeText.innerText = String(data.likes);
                            })
                            .catch((error) => {
                                console.error('There was a problem with the fetch operation:', error);
                            });
                    }
                },
                initLike: (post_id: string, apiUrl: string) => {
                    var likelist = localStorage.getItem('lieklist') || '';
                    var likeButton = document.querySelector<HTMLElement>('.post_like');
                    var likeText = document.querySelector<HTMLElement>('.post_likes');
                    if (likelist.indexOf(post_id + ',') != -1) {
                        likeButton?.classList.add('active');
                    }
                    fetch(`${apiUrl}/action?type=like&post_id=${post_id}`)
                        .then((res) => {
                            return res.json();
                        })
                        .then((data: { likes?: number }) => {
                            if (data.likes) {
                                if (likeButton) likeButton.dataset.like = String(data.likes);
                                if (likeText) likeText.innerText = String(data.likes);
                            } else {
                                if (likeButton) likeButton.dataset.like = '0';
                                if (likeText) likeText.innerText = '0';
                            }
                        })
                        .catch((error) => {
                            if (likeButton) likeButton.dataset.like = '0';
                            if (likeText) likeText.innerText = '0';
                            console.error('There was a problem with the fetch operation:', error);
                        });
                    return true;
                },
                initViews: (post_id: string, apiUrl: string) => {
                    var viewlist = localStorage.getItem('viewlist') || '';
                    var viewText = document.querySelector<HTMLElement>('.post_views');

                    if (viewlist.indexOf(post_id + ',') != -1) {
                        fetch(`${apiUrl}/action?type=view&post_id=${post_id}`)
                            .then((res) => {
                                return res.json();
                            })
                            .then((data: { Views?: number }) => {
                                if (data.Views) {
                                    if (viewText) viewText.innerText = String(data.Views);
                                } else {
                                    if (viewText) viewText.innerText = '0';
                                }
                            });
                    } else {
                        fetch(`${apiUrl}/action?type=view&post_id=${post_id}`, { method: 'post' })
                            .then((res) => {
                                return res.json();
                            })
                            .then((data: { Views: number }) => {
                                localStorage.setItem('viewlist', viewlist + post_id + ',');
                                if (viewText) viewText.innerText = String(data.Views);
                            })
                            .catch((error) => {
                                if (viewText) viewText.innerText = '0';
                                console.error('There was a problem with the fetch operation:', error);
                            });
                    }

                    return true;
                }
            };

            postAction.initLike(post_id, apiUrl);
            postAction.initViews(post_id, apiUrl);
            likeNode.addEventListener('click', () => {
                postAction.like(post_id, apiUrl);
            });
        }
    });
</script>
