---
import { Heart } from '@lucide/astro';
---

<div class="post_action flex flex-wrap justify-center">
    <div class="post_like">
        <Heart class="book-icon" />

        <div class="post_like_desc">「 觉得本文不错？点个赞把！... 」</div>
    </div>
</div>

<script>
    import cocoMessage from '../../lib/coco-message';
    import { artalkPageKey, fetchArtalkPageStats, hasLiked, markLiked, voteArtalkPageUp } from '../../lib/artalk-stats';

    const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

    document.addEventListener('astro:page-load', async () => {
        cocoMessage.insertCSS();

        const likeNode = document.querySelector<HTMLElement>('.post_like');
        if (!likeNode) return;

        const likeText = document.querySelector<HTMLElement>('.post_likes');
        const pageKey = artalkPageKey();
        let pageId = 0;
        let voting = false;
        let votedInThisView = false;

        const setActive = () => likeNode.classList.add('active');

        if (hasLiked(pageKey)) setActive();

        const loadStats = async () => {
            let stats = await fetchArtalkPageStats(pageKey).catch(() => null);
            // 新文章第一次访问时，Artalk 的 PV 初始化可能还没来得及创建 page 记录，稍后重试一次
            if (!stats || stats.id === 0) {
                await sleep(800);
                stats = await fetchArtalkPageStats(pageKey).catch(() => null);
            }
            if (!stats || !likeNode.isConnected) return;

            pageId = stats.id;
            // 避免慢请求在用户已经点赞之后把数字覆盖回旧值
            if (likeText && !votedInThisView) likeText.innerText = String(stats.voteUp);
        };

        const handleLike = async () => {
            if (voting) return;

            if (hasLiked(pageKey)) {
                setActive();
                cocoMessage.success('你已经点过赞了 ❤️');
                return;
            }

            voting = true;

            try {
                if (!likeNode.isConnected) return;
                if (pageId <= 0) {
                    const stats = await fetchArtalkPageStats(pageKey).catch(() => null);
                    if (stats) {
                        pageId = stats.id;
                        if (likeText) likeText.innerText = String(stats.voteUp);
                    }
                }
                if (pageId <= 0) {
                    cocoMessage.error('点赞失败，请稍后再试');
                    return;
                }

                const previousUp = Number(likeText?.innerText || 0);
                const { up } = await voteArtalkPageUp(pageId);
                votedInThisView = true;

                if (up < previousUp) {
                    // Artalk 按 IP 去重：这次点击实际取消了此前的点赞
                    likeNode.classList.remove('active');
                    if (likeText) likeText.innerText = String(up);
                    cocoMessage.info('已取消此前的点赞');
                    return;
                }

                markLiked(pageKey);
                setActive();
                if (likeText) likeText.innerText = String(up);
                cocoMessage.success('点赞成功，谢谢你的 ❤️');
            } catch (error) {
                console.error('Artalk vote failed:', error);
                cocoMessage.error('点赞失败，请稍后再试');
            } finally {
                voting = false;
            }
        };

        if (likeNode.dataset.bound !== 'true') {
            likeNode.dataset.bound = 'true';
            likeNode.addEventListener('click', handleLike);
        }

        await loadStats();
    });
</script>
