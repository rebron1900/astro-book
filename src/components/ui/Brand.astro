---
import { BadgeCheck } from '@lucide/astro';
import { settings } from '../../api/store';

// settings 来自 Ghost，构建期必定存在；此处断言非空以简化模板访问
const site = settings!;
---

<h2 class="book-brand">
    <script>
        import initWebSocket from '../../lib/client/actives';
        import { createTippy } from '../../lib/client/tippy';

        document.addEventListener('astro:page-load', () => {
            const actives = createTippy('.actives img', {
                placement: 'right',
                maxWidth: 300
            });
            initWebSocket(actives);

            // logo 的 tooltip 统一走 tippy（和站内其他 tooltip 同一套外观），位置固定在 logo 下方
            const brand = document.querySelector<HTMLElement>('.book-brand');
            // 只挂主 logo，避免和 .actives 上的在线状态 tooltip 叠加
            const logo = brand?.querySelector<HTMLImageElement>('.site-logo > img');
            if (!brand || !logo) return;

            if (logo.dataset.logoTip) {
                createTippy(logo, {
                    content: logo.dataset.logoTip,
                    placement: 'bottom',
                    offset: [0, 8],
                    appendTo: () => brand.closest<HTMLElement>('.book-menu-content') ?? document.body
                });
            }
        });
    </script>
    <a class="flex align-center" href="/" title="">
        {
            site.icon && (
                <div class="flex site-logo">
                    <div class="og-image bislight" style={'filter: blur(8px);height: 1.8em;width: 1.8em;background-image: url(/logo.svg);opacity: 1;'} />

                    <img src="/logo.svg" alt={site.title} data-logo-tip={`${site.title} | ${site.description}`} />
                    <div class="actives">
                        <img
                            src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII="
                            data-tippy-content=""
                            data-tippy-placement="bottom-start"
                        />
                    </div>
                </div>
            )
        }
        <div class="flex flex-direction" aria-label=`${site.title} | ${site.description }`>
            <span class="site-title flex align-center ellipsis">{site.title}<BadgeCheck class="book-icon" /></span>
            <span class="site-description ellipsis">{site.description}</span>
        </div>
    </a>
</h2>
