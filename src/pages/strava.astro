---
import { pages, settings } from '../api/store';
import activitiesJson from '../data/strava.json';

import BaseLayout from '../layouts/BaseLayout.astro';
import Head from '../components/islands/Head.astro';
import Comments from '../components/islands/Comments.astro';
import Relitu from '../components/islands/Relitu.jsx';
import Header from '../components/layout/Header.astro';
import Menu from '../components/layout/Menu.astro';
import PostMeta from '../components/ui/PostMeta.astro';
import { Markup } from 'astro-remote';
import CodeSlot from '../components/islands/CodeSlot.astro';
import IFrameSlot from '../components/ui/IFrameSlot.astro';
import RemotePicture from '../components/ui/RemotePicture.astro';
import Columns from '../components/shortcode/Columns.astro';
import Details from '../components/shortcode/Details.astro';
import Link from '../components/shortcode/Link.astro';
import OGCard from '../components/shortcode/OGCard.astro';
import StravaRelitu from '../components/islands/StravaRelitu.jsx';

const page = pages.find((post) => post.slug == 'strava');

if (!page) {
    throw new Error('strava page not found');
}

// 从本地同步的 JSON 读取活动数据（构建时无网络依赖）
const activities = activitiesJson;
---

<BaseLayout post={page}>
    <Head slot="head" post={page} site={settings} title={page?.title + ' | ' + settings?.title + ' - ' + settings?.description} />

    <Header slot="header" title={page.title} />
    <Menu slot="menu" />

    <article slot="content" class="markdown book-article">
        <h1 class="book-title">{page.title}</h1>
        <PostMeta post={page} isFeature={true} />

        <StravaRelitu activities={activities} />
        <script>
            import initMap from '../lib/client/strava';

            document.addEventListener('astro:page-load', () => {
                initMap();
            });
        </script>
        <div id="map" class="footer-map"></div>

        {
            page.html && (
                <Markup
                    content={page.html}
                    sanitize={{ allowComponents: true, allowCustomElements: true }}
                    components={{ pre: CodeSlot, img: RemotePicture, iframe: IFrameSlot, details: Details, columns: Columns, a: Link, ogcard: OGCard }}
                />
            )
        }
    </article>

    <Comments slot="comments" />

    <Relitu slot="relitu" />
</BaseLayout>
