---
import { pages, settings, authors } from '../../api/store';
import config from '../../config';
import memosJson from '../../data/memos.json';
import type { Memo } from '../../api/types';
import type { GetStaticPathsOptions } from 'astro';
import { relativeTime } from '../../lib/utils/help';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Head from '../../components/islands/Head.astro';
import Relitu from '../../components/islands/Relitu.jsx';
import Header from '../../components/layout/Header.astro';
import Top from '../../components/ui/Top.astro';
import Menu from '../../components/layout/Menu.astro';
import TocTagloop from '../../components/islands/TocTagloop.astro';
import { Markdown } from 'astro-remote';
import CodeSlot from '../../components/islands/CodeSlot.astro';
import IFrameSlot from '../../components/ui/IFrameSlot.astro';
import RemotePicture from '../../components/ui/RemotePicture.astro';
import Columns from '../../components/shortcode/Columns.astro';
import Details from '../../components/shortcode/Details.astro';
import Link from '../../components/shortcode/Link.astro';
import OGCard from '../../components/shortcode/OGCard.astro';

const custompage = pages.find((post) => post.slug == 'now');

if (!custompage) {
    throw new Error('now page not found');
}

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    return paginate(memosJson as Memo[], { pageSize: 15 });
}

const { page } = Astro.props;
---

<BaseLayout post={custompage}>
    <Head slot="head" post={custompage} site={settings} title={custompage?.title + ' | ' + settings?.title + ' - ' + settings?.description}> afas </Head>

    <Header slot="header" title={custompage.title} />
    <Menu slot="menu" />

    <div slot="content" class="markdown book-article page-memos">
        <div class="memo-header" style={`background-image: url(${authors.authors[0].cover_image});`}>
            <div class="memo-info">
                <div class="flex align-center">
                    <span class="memo-title">{authors.authors[0].name}</span>
                    <div class="memo-avartar">
                        <img class="" src={authors.authors[0].profile_image} data-sizes="auto" />
                    </div>
                </div>
                <div class="memo-desc">纵使生活有千般不如意，也不要自暴自弃！</div>
            </div>
        </div>

        <div id="atk-memoslist">
            {
                page.data.map((memo) => (
                    <div class="atk-comment threads-item">
                        <div class="threads-avatar">
                            <a target="_blank" rel="noreferrer noopener nofollow" href={config.memos.siteURL + '/m/' + memo.id}>
                                <img src={authors.authors[0].profile_image} alt={memo.creatorName} />
                            </a>
                        </div>

                        <div class="threads-main">
                            <div class="threads-head">
                                <span class="threads-name">{memo.creatorName}</span>
                                <span class="threads-time">{relativeTime(memo.updatedTs)}</span>
                            </div>

                            <div class="threads-body atk-content">
                                {memo.content && (
                                    <Markdown
                                        content={memo.content}
                                        sanitize={{ allowComponents: true, allowCustomElements: true }}
                                        components={{
                                            pre: CodeSlot,
                                            img: RemotePicture,
                                            iframe: IFrameSlot,
                                            details: Details,
                                            columns: Columns,
                                            a: Link,
                                            ogcard: OGCard
                                        }}
                                    />
                                )}
                                <OGCard text={memo.content} />

                                {memo.resourceList.length > 0 && (
                                    <div class={`image-grid image-count-${memo.resourceList.length}`} view-image="">
                                        {memo.resourceList.map((r) => {
                                            if (r.type == 'image') {
                                                return (
                                                    <div class="image-container">
                                                        <RemotePicture src={r.externalLink} alt={r.filename} classNames="image-item" />
                                                    </div>
                                                );
                                            } else if (r.type == 'video') {
                                                return (
                                                    <div class="image-container">
                                                        <video src={r.externalLink} controls width="640" height="360">
                                                            您的浏览器不支持 HTML5 视频标签
                                                        </video>
                                                    </div>
                                                );
                                            }
                                        })}
                                    </div>
                                )}
                            </div>
                        </div>
                    </div>
                ))
            }
            <div class="flex flex-wrap btn-more justify-center" style="padding: 3rem; gap:1.5rem">
                {
                    page.url.next && (
                        <a
                            class="loader"
                            href="javascript:(void)"
                            hx-trigger="revealed"
                            hx-get={`${page.url.next}`}
                            hx-target="#atk-memoslist"
                            hx-swap="beforeend "
                            hx-select="#atk-memoslist"
                            hx-push-url="true"
                        />
                    )
                }
            </div>
        </div>
    </div>

    <Relitu slot="relitu" />

    <Fragment slot="toc">
        <Relitu />
        <TocTagloop />
        <Top />
    </Fragment>
</BaseLayout>
