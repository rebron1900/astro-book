---
import { pages, settings } from '../api/store';
import activitiesJson from '../data/activities.json';
import type { Activity } from '../lib/activity-types';
import { buildRecords, compactRecords, defaultScope, groupByMonth } from '../lib/exercise';
import { loadFootprintData } from '../lib/footprint-data';
import { buildAchievements, buildFootprintSummary } from '../lib/footprint-achievements';
import elevationsJson from '../data/place-elevations.json';

import BaseLayout from '../layouts/BaseLayout.astro';
import Head from '../components/islands/Head.astro';
import Header from '../components/layout/Header.astro';
import Menu from '../components/layout/Menu.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import { ArrowDown, ArrowLeft, ArrowRight, ArrowUp, BookmarkCheck, CalendarRange, Map as MapIcon, MapPin, Mountain, NotebookPen, PenLine, Ruler, Sparkles } from '@lucide/astro';
import ExerciseMapPanel from '../components/islands/ExerciseMapPanel';
import ExerciseTimeline from '../components/islands/ExerciseTimeline.astro';
import ExerciseSidebar from '../components/islands/ExerciseSidebar';
import ExerciseFootprint from '../components/islands/ExerciseFootprint';

// 时间线、运动侧栏、地图卡片的样式都在 exercise.scss 里，必须一起引入，
// 否则岛里的 .ex-* / .ex-fp-* 结构就是裸的
import '../styles/pages/exercise.scss';
import '../styles/pages/activity.scss';

// 沿用运动页的 Ghost 记录拿标题；页面布局与 /exercise/ 一致（中间内容 + 右侧栏）
const page = pages.find((post) => post.slug == 'exercise') ?? pages.find((post) => post.slug == 'strava');

const allRecords = buildRecords(activitiesJson as unknown as Activity[]);
const groups = groupByMonth(allRecords);
const initialScope = defaultScope(allRecords);
const records = compactRecords(allRecords);
const footprint = loadFootprintData();
const mapToken = import.meta.env.PUBLIC_MAP_KEY;

// 标点海拔由 scripts/fetch-elevations.mjs 落盘（构建期不联网）
const elevations = (elevationsJson as { places: Record<string, number> }).places;
const achievements = buildAchievements(footprint, elevations);
const summary = buildFootprintSummary(footprint);

/** 分布榜最多显示 8 行：前 7 行正常，第 8 行聚合没展示的部分 */
const MAX_DISTRIBUTION_ROWS = 8;
const uniqueNames = (names: string[]) => [...new Set(names)];

const yearBucketsDesc = [...summary.years].sort((a, b) => b.year - a.year);
const yearRows =
    yearBucketsDesc.length > MAX_DISTRIBUTION_ROWS
        ? [
              ...yearBucketsDesc.slice(0, MAX_DISTRIBUTION_ROWS - 1).map((bucket) => ({
                  label: String(bucket.year),
                  count: bucket.count,
                  places: bucket.places,
                  tipTitle: `${bucket.year} 年`
              })),
              (() => {
                  const rest = yearBucketsDesc.slice(MAX_DISTRIBUTION_ROWS - 1);
                  const newest = rest[0].year;
                  const oldest = rest[rest.length - 1].year;
                  const label = newest === oldest ? String(oldest) : `${oldest}-${newest}`;
                  return {
                      label,
                      count: rest.reduce((sum, bucket) => sum + bucket.count, 0),
                      places: uniqueNames(rest.flatMap((bucket) => bucket.places)),
                      tipTitle: label
                  };
              })()
          ]
        : yearBucketsDesc.map((bucket) => ({
              label: String(bucket.year),
              count: bucket.count,
              places: bucket.places,
              tipTitle: `${bucket.year} 年`
          }));

const provinceBuckets = summary.provinces;
const provinceRows =
    provinceBuckets.length > MAX_DISTRIBUTION_ROWS
        ? [
              ...provinceBuckets.slice(0, MAX_DISTRIBUTION_ROWS - 1).map((item) => ({
                  label: item.province,
                  count: item.places,
                  names: item.names,
                  tipTitle: item.province
              })),
              (() => {
                  const rest = provinceBuckets.slice(MAX_DISTRIBUTION_ROWS - 1);
                  return {
                      label: '其他',
                      count: rest.reduce((sum, item) => sum + item.places, 0),
                      names: uniqueNames(rest.flatMap((item) => item.names)),
                      tipTitle: '其他'
                  };
              })()
          ]
        : provinceBuckets.map((item) => ({
              label: item.province,
              count: item.places,
              names: item.names,
              tipTitle: item.province
          }));

const maxYear = Math.max(1, ...yearRows.map((row) => row.count));
// 气泡里要能点，所以把「名字」换成「id + 名字」
const placeIdByName = new Map(footprint.places.map((place) => [place.name, place.id]));
const toPlaceRefs = (names: string[]) => names.map((name) => ({ id: placeIdByName.get(name) ?? name, name }));
// 成就图标：按 key 取，未收录的用 Sparkles 兜底
const ACHIEVEMENT_ICONS: Record<string, typeof Sparkles> = {
    north: ArrowUp,
    south: ArrowDown,
    east: ArrowRight,
    west: ArrowLeft,
    province: MapIcon,
    writer: PenLine,
    span: Ruler,
    elevation: Mountain
};
const maxProvince = Math.max(1, ...provinceRows.map((row) => row.count));

const layoutPage = page ? { ...page, tags: (page.tags ?? []).filter((tag) => tag.slug !== 'hash-page-fullwidth') } : undefined;
const years = footprint.stats.years;
const note = `${footprint.stats.places} 个地点 · ${footprint.stats.articles} 篇游记${years ? ` · ${years[0]}—${years[1]}` : ''}`;
---

<BaseLayout post={layoutPage}>
    <Head
        slot="head"
        post={layoutPage}
        site={settings}
        title={`运动与足迹 | ${settings?.title} - ${settings?.description}`}
        description="同一条时间线，两种看法：一边是每次出门的路线和成绩，一边是那些路线上真正站过的地方。"
        og_url={`${import.meta.env.SITE}/activity/`}
    />

    <Header slot="header" title="运动与足迹" />
    <Menu slot="menu" />

    <article slot="content" class="exercise-page activity-page" data-activity-mode="exercise">
        <label for="toc-control" class="act-toc-scrim" aria-label="关闭侧边栏"></label>
        <PageIntro
            title="动起来的日子，都留下了痕迹。"
            copy="同一条时间线，两种看法：一边是每次出门的路线和成绩，一边是那些路线上真正站过的地方。地图右上角可以随时换。"
            note={note}
        />

        <div class="act-stage">
            <div class="act-switch-bar">
                <div class="act-switch" role="group" aria-label="切换运动 / 足迹">
                    <span class="act-thumb" aria-hidden="true"></span>
                    <button class="act-switch-btn" type="button" data-act-mode="exercise" aria-pressed="true">运动</button>
                    <button class="act-switch-btn" type="button" data-act-mode="footprint" aria-pressed="false">足迹</button>
                </div>
            </div>

            <div class="act-mode act-mode--exercise">
                <div class="ex-main">
                    <ExerciseMapPanel
                        client:load
                        records={records}
                        initialScope={initialScope}
                        token={mapToken}
                        routesUrl="/exercise-routes.json"
                        activeMode="exercise"
                    />
                    <ExerciseTimeline groups={groups} scope={initialScope} />
                </div>
            </div>

            <div class="act-mode act-mode--footprint">
                <div class="act-fp-sentinel" aria-hidden="true"></div>
                <ExerciseFootprint client:load data={footprint} token={mapToken} activeMode="footprint" />
            </div>
        </div>
    </article>

    <Fragment slot="toc">
        <div class="act-side act-side--exercise">
            <ExerciseSidebar client:load records={records} initialScope={initialScope} />
        </div>

        <div class="act-side act-side--footprint">
            <div class="ex-stats-stack">
                <div class="ex-stats-body">
                    <section class="ex-ov" aria-label="足迹总览">
                        <header class="ex-ov-head">
                            <h2 class="ex-ov-title">足迹总览</h2>
                        </header>
                        <dl class="ex-ov-metrics">
                            <div class="ex-ov-metric">
                                <dt><MapPin size={12} aria-hidden="true" />地点</dt>
                                <dd>{footprint.stats.places}<small>个</small></dd>
                            </div>
                            <div class="ex-ov-metric">
                                <dt><NotebookPen size={12} aria-hidden="true" />游记</dt>
                                <dd>{footprint.stats.articles}<small>篇</small></dd>
                            </div>
                            <div class="ex-ov-metric">
                                <dt><BookmarkCheck size={12} aria-hidden="true" />有游记</dt>
                                <dd>{footprint.stats.matchedPlaces}<small>个地点</small></dd>
                            </div>
                            {
                                years && (
                                    <div class="ex-ov-metric">
                                        <dt><CalendarRange size={12} aria-hidden="true" />写作跨度</dt>
                                        <dd>{years[1] - years[0] + 1}<small>年</small></dd>
                                    </div>
                                )
                            }
                        </dl>
                    </section>

                    <hr class="ex-stats-divider" />

                    <section class="ex-ov act-tabs" aria-label="游记分布">
                        <input class="act-tabs-input" type="radio" name="act-dist" id="act-dist-year" checked />
                        <input class="act-tabs-input" type="radio" name="act-dist" id="act-dist-province" />

                        <div class="act-tabs-head">
                            <label class="act-tabs-tab" for="act-dist-year">游记年份</label>
                            <label class="act-tabs-tab" for="act-dist-province">去得最多的省</label>
                        </div>

                        <ul class="act-bars act-tabs-panel act-tabs-panel--year">
                            {
                                yearRows.map((row) => (
                                    <li
                                        class="act-bar-row"
                                        data-tip-title={row.tipTitle}
                                        data-tip-places={row.places.length > 0 ? JSON.stringify(toPlaceRefs(row.places)) : undefined}
                                    >
                                        <span class="act-bar-label">{row.label}</span>
                                        <span class="act-bar-track">
                                            <span class="act-bar-fill" style={`--w: ${Math.round((row.count / maxYear) * 100)}%`} />
                                        </span>
                                        <span class="act-bar-value">{row.count}</span>
                                    </li>
                                ))
                            }
                        </ul>

                        <ul class="act-bars act-tabs-panel act-tabs-panel--province">
                            {
                                provinceRows.map((row) => (
                                    <li class="act-bar-row" data-tip-title={row.tipTitle} data-tip-places={row.names.length > 0 ? JSON.stringify(toPlaceRefs(row.names)) : undefined}>
                                        <span class="act-bar-label act-bar-label--wide">{row.label}</span>
                                        <span class="act-bar-track">
                                            <span class="act-bar-fill" style={`--w: ${Math.round((row.count / maxProvince) * 100)}%`} />
                                        </span>
                                        <span class="act-bar-value">{row.count}</span>
                                    </li>
                                ))
                            }
                        </ul>
                    </section>

                    <hr class="ex-stats-divider" />

                    <section class="ex-ov" aria-label="成就">
                        <header class="ex-ov-head">
                            <h2 class="ex-ov-title">成就</h2>
                            <span class="ex-ov-range">{achievements.length} 项</span>
                        </header>
                        <div class="ex-ov-records act-ov-records">
                            {
                                achievements.map((item) => {
                                    const Icon = ACHIEVEMENT_ICONS[item.key] ?? Sparkles;
                                    return item.placeId ? (
                                        <button class="ex-ov-record" type="button" data-act-place={item.placeId} title={`在地图上看看 ${item.value}`}>
                                            <Icon class="ex-ov-record-icon" size={12} aria-hidden="true" />
                                            <span class="ex-ov-record-label">{item.label}</span>
                                            <span class="ex-ov-record-value">{item.value}</span>
                                        </button>
                                    ) : (
                                        <div class="ex-ov-record act-ov-record--static">
                                            <Icon class="ex-ov-record-icon" size={12} aria-hidden="true" />
                                            <span class="ex-ov-record-label">{item.label}</span>
                                            <span class="ex-ov-record-value">{item.value}</span>
                                        </div>
                                    );
                                })
                            }
                        </div>
                    </section>
                </div>
            </div>

            {/* 地点筛选暂时下线：要恢复就把 ActivityPlaceFilter 放回这里（组件和事件通道都还在） */}
        </div>
    </Fragment>
</BaseLayout>

<script>
    import initActivityMode from '../lib/client/activity-mode';
    import { onPageLoad } from '../lib/client/mount';

    onPageLoad(initActivityMode);
</script>
