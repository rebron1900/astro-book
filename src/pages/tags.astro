---
import { tags, pages, settings } from '../api/store';
import type { Tag } from '@ts-ghost/content-api';

import BaseLayout from '../layouts/BaseLayout.astro';
import Head from '../components/islands/Head.astro';
import Comments from '../components/islands/Comments.astro';
import Relitu from '../components/islands/Relitu';
import TocTagloop from '../components/islands/TocTagloop.astro';
import Header from '../components/layout/Header.astro';
import Top from '../components/ui/Top.astro';
import Menu from '../components/layout/Menu.astro';
import PageIntro from '../components/ui/PageIntro.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/pages/tags.scss';
import { normalizeSlug } from '../lib/utils/help';

const page = pages.find((post) => post.slug == 'tags');

type TagWithPosts = Tag & {
    posts?: Array<{
        id?: string;
        title?: string;
        published_at?: string;
        [key: string]: unknown;
    }>;
};

function tagCount(item: TagWithPosts) {
    return Number(item.count?.posts ?? item.posts?.length ?? 0);
}

const tagged = tags as TagWithPosts[];
const publicTags = tagged
    .filter((item) => item.visibility === 'public')
    .sort((a, b) => tagCount(b) - tagCount(a));

const postIds = new Set<string>();
publicTags.forEach((item) => {
    (item.posts ?? []).forEach((post) => {
        if (post.id) postIds.add(post.id);
    });
});

const tagTotal = publicTags.length;
const postTotal = postIds.size;
---

<BaseLayout post={page}>
    <Head slot="head" post={page} site={settings} title={page?.title + ' | ' + settings?.title + ' - ' + settings?.description} />

    <Header slot="header" title={page?.title} />
    <Menu slot="menu" />

    <div slot="content" class="markdown book-article tags-page">
        <PageIntro
            title="散落的词，慢慢连成一张网。"
            copy="写下的东西多了，就长出这些词。有的关于技术，有的关于生活，有的只是路上看见的一棵树；顺着一个词点进去，能读到一段连起来的时间。"
        />

        <p class="tags-summary">
            <span><strong>{tagTotal}</strong> 个公开标签</span>
            <span><strong>{postTotal}</strong> 篇相关文章</span>
        </p>

        {publicTags.length > 0 ? (
            <div class="tags-grid">
                {publicTags.map((item) => {
                    const latest = item.posts?.[0];
                    return (
                        <a class="tag-card" href={`/tag${normalizeSlug(item.slug)}`}>
                            <div class="tag-card-head">
                                <span class="tag-hash" aria-hidden="true">#</span>
                                <h2 class="tag-name">{item.name}</h2>
                                <span class="tag-count">{tagCount(item)}</span>
                            </div>
                            {latest && (
                                <div class="tag-latest">
                                    <span class="tag-latest-label">最近更新</span>
                                    <span class="tag-latest-title">{latest.title}</span>
                                    <time class="tag-date">{latest.published_at?.slice(0, 10)}</time>
                                </div>
                            )}
                        </a>
                    );
                })}
            </div>
        ) : (
            <p class="tags-empty">还没有公开标签。</p>
        )}
    </div>

    <Comments slot="comments" />
    <Footer slot="footer" post={page} />

    <Fragment slot="toc">
        <Relitu />
        <TocTagloop />
        <Top />
    </Fragment>
</BaseLayout>
