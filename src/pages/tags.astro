---
import { tags, pages, settings } from '../api/store';
import type { Tag } from '@ts-ghost/content-api';

import BaseLayout from '../layouts/BaseLayout.astro';
import Head from '../components/islands/Head.astro';
import Comments from '../components/islands/Comments.astro';
import Relitu from '../components/islands/Relitu';
import TocTagloop from '../components/islands/TocTagloop.astro';
import Header from '../components/layout/Header.astro';
import Top from '../components/ui/Top.astro';
import Menu from '../components/layout/Menu.astro';
import { Markup } from 'astro-remote';
import CodeSlot from '../components/islands/CodeSlot.astro';
import IFrameSlot from '../components/ui/IFrameSlot.astro';
import RemotePicture from '../components/ui/RemotePicture.astro';
import Footer from '../components/layout/Footer.astro';
import Now from '../components/shortcode/Now.astro';
import Columns from '../components/shortcode/Columns.astro';
import Details from '../components/shortcode/Details.astro';
import Link from '../components/shortcode/Link.astro';
import OGCard from '../components/shortcode/OGCard.astro';
import { normalizeSlug } from '../lib/utils/help';
import { Tags as ITags } from '@lucide/astro';

const page = pages.find((post) => post.slug == 'tags');
---

<BaseLayout>
    <Head slot="head" post={page} site={settings} title={page?.title + ' | ' + settings?.title + ' - ' + settings?.description} />

    <Header slot="header" title={page?.title} />
    <Menu slot="menu" />

    <div slot="content" class="markdown book-article">
        <h1 class="book-title"><ITags /> {page?.title}</h1>
        <p></p>
        {
            page?.html && (
                <Markup
                    content={page.html}
                    sanitize={{ allowComponents: true, allowCustomElements: true }}
                    components={{
                        pre: CodeSlot,
                        img: RemotePicture,
                        iframe: IFrameSlot,
                        details: Details,
                        columns: Columns,
                        Now: Now,
                        a: Link,
                        ogcard: OGCard
                    }}
                />
            )
        }

        <div class="book-columns flex flex-wrap">
            {
                tags
                    .filter((item: Tag) => item.visibility === 'public')
                    .sort((a: Tag, b: Tag) => (b.count?.posts ?? 0) - (a.count?.posts ?? 0))
                    .map((item: Tag) => (
                        <div class="flex-even markdown-inner">
                            {' '}
                            <a href={`/tag${normalizeSlug(item.slug)}`}>#{item.name}</a>
                            <sup>{item.count?.posts ?? 0}</sup>
                        </div>
                    ))
            }
        </div>
    </div>

    <Comments slot="comments" />
    <Footer slot="footer" post={page} />

    <Fragment slot="toc">
        <Relitu />
        <TocTagloop />
        <Top />
    </Fragment>
</BaseLayout>
