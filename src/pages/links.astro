---
import { pages, settings, flux, fluxLost } from '../api/store';
import { normalizeData } from '../lib/utils/help';
import type { FluxLostFeed } from '../api/types';

import BaseLayout from '../layouts/BaseLayout.astro';
import Head from '../components/islands/Head.astro';
import Comments from '../components/islands/Comments.astro';
import Header from '../components/layout/Header.astro';
import Menu from '../components/layout/Menu.astro';
import { Markup } from 'astro-remote';
import CodeSlot from '../components/islands/CodeSlot.astro';
import IFrameSlot from '../components/ui/IFrameSlot.astro';
import RemotePicture from '../components/ui/RemotePicture.astro';
import Columns from '../components/shortcode/Columns.astro';
import Details from '../components/shortcode/Details.astro';
import Link from '../components/shortcode/Link.astro';
import { DoorOpen, Unplug } from '@lucide/astro';
import ScrollReveal from '../components/islands/ScrollReveal.astro';

const page = pages.find((post) => post.slug == 'links');

const lostReasonLabels = { error: '抓取失败', empty: '暂无文章', disabled: '已停用' } as const;

function lostReasonTitle(item: FluxLostFeed): string | undefined {
    if (item.error) return item.error;
    const lastEntry = normalizeData(item.last_entry_at);
    return lastEntry ? `最后文章：${lastEntry}` : undefined;
}
---

<BaseLayout post={page}>
    <Head slot="head" post={page} site={settings} title={page?.title + ' | ' + settings?.title + ' - ' + settings?.description} />

    <Header slot="header" title={page?.title} />
    <Menu slot="menu" />

    <article slot="content" class="markdown book-article">
        <h1 class="book-title"><DoorOpen /> {page?.title}</h1>

        {
            page?.html && (
                <Markup
                    content={page.html}
                    sanitize={{ allowComponents: true, allowCustomElements: true }}
                    components={{ pre: CodeSlot, img: RemotePicture, iframe: IFrameSlot, details: Details, columns: Columns, a: Link }}
                />
            )
        }
        <div class="book-columns flex flex-wrap">
            {
                flux.map((item) => (
                    <div class="flex-even markdown-inner">
                        <h3 class="book-title flex">
                            <img loading="lazy" style="width: 1.5em;margin-right: 0.3em;" src={'https://icon.bqb.cool/?url=' + (item.feed?.site_url || '')} />
                            <Link href={item.feed?.site_url || '#'} class="ellipsis" target="_blank">
                                {item.feed?.title || 'Unknown Feed'}
                            </Link>
                        </h3>

                        <div class="ellipsis">
                            <Link href={item.url || (item.link as string | undefined) || '#'} class="ellipsis" target="_blank">
                                {item.title || 'Untitled'}
                            </Link>
                        </div>
                        <div>
                            <span>{normalizeData(item.published_at || item.created_at || (item.date as string | number))}</span>
                        </div>
                    </div>
                ))
            }
        </div>

        {
            fluxLost.length > 0 && (
                <section class="lost-feeds" aria-labelledby="lost-feeds-title">
                    <h2 class="book-title" id="lost-feeds-title">
                        <Unplug /> 失联订阅
                    </h2>
                    <p class="lost-feeds-desc">以下 {fluxLost.length} 个订阅暂时没有获取到最新文章，可能已经失效或停更。</p>
                    <ul class="lost-feeds-list">
                        {fluxLost.map((item) => (
                            <li class="lost-feed">
                                <img loading="lazy" src={'https://icon.bqb.cool/?url=' + (item.site_url || '')} alt="" width="20" height="20" />
                                <Link href={item.site_url || '#'} class="lost-feed-link ellipsis" target="_blank" title={item.title}>
                                    {item.title}
                                </Link>
                                <span class="lost-feed-reason" title={lostReasonTitle(item)}>
                                    {lostReasonLabels[item.reason]}
                                </span>
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }
        <ScrollReveal selector=".book-columns > .flex-even, .lost-feed" />
    </article>
    <Comments slot="comments" />
</BaseLayout>
