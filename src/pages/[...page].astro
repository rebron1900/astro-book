---
import type { GetStaticPathsOptions } from 'astro';
import { postsAll, settings } from '../api/store';

import BaseLayout from '../layouts/BaseLayout.astro';
import Head from '../components/islands/Head.astro';
import List from '../components/islands/List.astro';
import Pagination from '../components/ui/Pagination.astro';
import Relitu from '../components/islands/Relitu';
import TocTagloop from '../components/islands/TocTagloop.astro';
import Header from '../components/layout/Header.astro';
import Top from '../components/ui/Top.astro';
import Menu from '../components/layout/Menu.astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    return paginate(postsAll, {
        pageSize: 10
    });
}

const { page } = Astro.props;
---

<BaseLayout>
    <Head slot="head" site={settings} title={settings?.title + ' | ' + settings?.description} og_url={import.meta.env.SITE + page.url.current} />

    <Header slot="header" title={settings?.title} />

    <Menu slot="menu" title={page.currentPage != 1 ? `第 ${page.currentPage} 页` : ''} />

    <List slot="content" page={page} isFeature={false} />

    <Pagination slot="pagination" page={page} />

    <Fragment slot="toc">
        <Relitu />
        <TocTagloop />
        <Top />
    </Fragment>
</BaseLayout>
