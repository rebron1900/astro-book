---
import type { GetStaticPathsOptions } from 'astro';
import { timeline } from '../../api/store';
import DoubanTimelinePage from '../../components/douban/DoubanTimelinePage.astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    const neodbEntries = timeline.filter((entry) => entry.kind === 'neodb');
    return paginate(neodbEntries, { pageSize: 10 });
}

const { page } = Astro.props;
---

<DoubanTimelinePage page={page} activeCategory="all" />
