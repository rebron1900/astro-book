---
import { pages, settings, neodb } from '../../api/store';
import type { NeoDBMark } from '../../api/types';
import { doubanGroupByDate } from '../../lib/utils/help';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Head from '../../components/islands/Head.astro';
import Relitu from '../../components/islands/Relitu.jsx';
import Header from '../../components/layout/Header.astro';
import Top from '../../components/ui/Top.astro';
import Menu from '../../components/layout/Menu.astro';
import Comments from '../../components/islands/Comments.astro';
import Markup from 'astro-remote/lib/Markup.astro';
import CodeSlot from '../../components/islands/CodeSlot.astro';
import IFrameSlot from '../../components/ui/IFrameSlot.astro';
import RemotePicture from '../../components/ui/RemotePicture.astro';
import Columns from '../../components/shortcode/Columns.astro';
import Details from '../../components/shortcode/Details.astro';
import Link from '../../components/shortcode/Link.astro';
import { Sparkles, MessageSquareMore } from '@lucide/astro';

const RECORD_META: Record<string, { label: string; action: string }> = {
    movie: { label: '电影', action: '观看' },
    tv: { label: '剧集', action: '观看' },
    book: { label: '书籍', action: '阅读' },
    game: { label: '游戏', action: '游玩' },
    music: { label: '音乐', action: '聆听' },
    podcast: { label: '播客', action: '收听' },
    performance: { label: '演出', action: '参加' }
};

function getRatingLabel(score: number) {
    const rating = Number(score);
    if (!Number.isFinite(rating)) return '';
    if (rating >= 10) return '神作';
    if (rating >= 8) return '夯爆了';
    if (rating >= 6) return '夯';
    if (rating >= 4) return '路人';
    if (rating >= 1) return '拉完了';
    return '';
}

function getRecordMeta(mark: NeoDBMark) {
    const category = mark.item.category;
    const meta = RECORD_META[category] ?? { label: category, action: '记录' };
    const created = mark.created_time ?? '';
    const date = created.slice(0, 10).replaceAll('-', '.');

    return {
        ...meta,
        title: mark.item.title_cn || mark.item.title || mark.title,
        date,
        score: mark.rating_grade || '—',
        ratingLabel: getRatingLabel(mark.rating_grade),
        comment: mark.comment_text?.trim() || '',
        code: mark.item.uuid.slice(-8).toUpperCase()
    };
}

const pageDouban = pages.find((post) => post.slug == 'douban');

export async function getStaticPaths() {
    const PAGE_SIZE = 30;
    const db = neodb.data;
    const lastPage = Math.max(1, Math.ceil(db.length / PAGE_SIZE));

    return Array.from({ length: lastPage }, (_, index) => {
        const currentPage = index + 1;
        return {
            params: { page: currentPage === 1 ? undefined : String(currentPage) },
            props: {
                data: db.slice(index * PAGE_SIZE, (index + 1) * PAGE_SIZE),
                currentPage,
                lastPage
            }
        };
    });
}

// 从 props 获取数据
const { data, currentPage, lastPage } = Astro.props;
const groupdata = doubanGroupByDate(data);
---

<BaseLayout post={pageDouban}>
    <Head slot="head" post={pageDouban} site={settings} title={pageDouban?.title + ' | ' + settings?.title + ' - ' + settings?.description} />

    <Header slot="header" title={pageDouban?.title} />
    <Menu slot="menu" />

    <article slot="content" class="markdown book-article">
        <h1 class="book-title">
            <Sparkles />
            {pageDouban?.title}
        </h1>
        {
            pageDouban?.html && (
                <Markup
                    content={pageDouban.html}
                    sanitize={{ allowComponents: true, allowCustomElements: true }}
                    components={{ pre: CodeSlot, img: RemotePicture, iframe: IFrameSlot, details: Details, columns: Columns, a: Link }}
                />
            )
        }

        <div class="db--container" x-data="douban">
            <nav class="db--nav" aria-label="书影音分类">
                <button type="button" class="db--navItem current" data-type="all" aria-pressed="true">全部</button>
                <button type="button" class="db--navItem" data-type="movie" aria-pressed="false">电影</button>
                <button type="button" class="db--navItem" data-type="tv" aria-pressed="false">剧集</button>
                <button type="button" class="db--navItem" data-type="book" aria-pressed="false">书籍</button>
                <button type="button" class="db--navItem" data-type="game" aria-pressed="false">游戏</button>
                <button type="button" class="db--navItem" data-type="music" aria-pressed="false">音乐</button>
                <button type="button" class="db--navItem" data-type="podcast" aria-pressed="false">播客</button>
                <button type="button" class="db--navItem" data-type="performance" aria-pressed="false">演出</button>
            </nav>

            <div class="db--genres"></div>
            <div class="db--list db--list__card" id="db--list__card">
                {
                    groupdata.map((post) =>
                        post.data.map((month) => (
                            <div class="db--listBydate">
                                <div class="db--titleDate">
                                    <div class="db--titleDate__day">{month.month}</div>
                                    <div class="db--titleDate__month">{post.year}</div>
                                </div>
                                <div class="db--dateList__card">
                                    {month.data &&
                                        month.data.map((monthdata) => {
                                            const record = getRecordMeta(monthdata);
                                            const coverUrl = `https://images.weserv.nl/?url=${encodeURIComponent(monthdata.item.cover_image_url ?? '')}&w=180&fit=cover`;
                                            return (
                                                <div class="db--item" data-itemtype={monthdata.item.category}>
                                                    <div class="db--card-front">
                                                        {record.comment && (
                                                            <span class="db--icon-comment" aria-hidden="true">
                                                                <MessageSquareMore size={16} />
                                                            </span>
                                                        )}
                                                        <div>
                                                            <img
                                                                loading="lazy"
                                                                src={coverUrl}
                                                                class="db--image"
                                                                alt={record.title}
                                                            />
                                                        </div>
                                                        <div class="db--score">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                                                <path d="M12 20.1l5.82 3.682c1.066.675 2.37-.322 2.09-1.584l-1.543-6.926 5.146-4.667c.94-.85.435-2.465-.799-2.567l-6.773-.602L13.29.89a1.38 1.38 0 0 0-2.581 0l-2.65 6.53-6.774.602C.052 8.126-.453 9.74.486 10.59l5.147 4.666c1.067.675 2.37-.322 2.09-1.584l-1.542 6.926C4.9 22.36 5.923 23.36 7 22.68L12 20.1z" />
                                                            </svg>
                                                            {record.score} · {record.label}
                                                        </div>
                                                        <div class="db--title ellipsis">
                                                            <a
                                                                href={monthdata.item.id}
                                                                target="_blank"
                                                                rel="noopener noreferrer"
                                                                title={record.title}
                                                                aria-describedby={`db-summary-${monthdata.item.uuid}`}
                                                            >
                                                                {record.title}
                                                            </a>
                                                            <span id={`db-summary-${monthdata.item.uuid}`} class="db--sr-only">
                                                                {record.label}{record.action}日期：{record.date}。评分：{record.score}。{record.comment ? `短评：${record.comment}` : '没有留下短评。'}
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <div
                                                        class="db--ticket-face"
                                                        style={`--ticket-cover: url("${coverUrl}")`}
                                                        role="group"
                                                        aria-label={`${record.title}的${record.action}记录`}
                                                    >
                                                        <div class="db--ticket-content">
                                                            <div class="db--ticket-topline">
                                                                <span>{record.label} / {record.action}</span>
                                                                <time datetime={monthdata.created_time}>{record.date}</time>
                                                            </div>
                                                            <div class="db--ticket-title-row">
                                                                <div class="db--ticket-title">{record.title}</div>
                                                                {record.ratingLabel && (
                                                                    <span class="db--ticket-rating-label" aria-label={`评分 ${record.score}：${record.ratingLabel}`}>
                                                                        {record.ratingLabel}
                                                                    </span>
                                                                )}
                                                            </div>
                                                            <div class="db--ticket-comment">
                                                                <div class="db--ticket-comment-head">
                                                                    <span class="db--ticket-comment-label">短评</span>
                                                                </div>
                                                                {record.comment ? <p>{record.comment}</p> : <p class="is-empty">没有留下短评</p>}
                                                            </div>
                                                            <div class="db--ticket-footer">
                                                                <span>NEODB</span>
                                                                <span>#{record.code}</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            );
                                        })}
                                </div>
                            </div>
                        ))
                    )
                }
                {
                    currentPage < lastPage && (
                        <div
                            class="loader db--load-more"
                            role="status"
                            aria-label="正在加载更多记录"
                            hx-trigger="intersect once"
                            hx-get={`/douban/${currentPage + 1}`}
                            hx-target="#db--list__card"
                            hx-swap="beforeend"
                            hx-select=".db--listBydate, .db--load-more"
                        ></div>
                    )
                }
            </div>

            <script>
                const douban = {
                    currentType: 'all' as string,
                    change: function (type: string) {
                        this.currentType = type;
                        // 选择所有具有data-itemtype属性的元素
                        const elements = document.querySelectorAll<HTMLElement>('[data-itemtype]');

                        // 遍历这些元素
                        elements.forEach(function (el) {
                            // 检查data-itemtype的值是否不等于'book'
                            const t = el.getAttribute('data-itemtype');
                            if (type == 'all') {
                                el.style.display = '';
                                return;
                            }
                            if (t !== type) {
                                // 如果不等于，隐藏该元素
                                el.style.display = 'none';
                            } else {
                                el.style.display = '';
                            }
                        });
                        this.hidden();
                    },
                    hidden: function () {
                        const cardElements = document.querySelectorAll<HTMLElement>('.db--listBydate');

                        cardElements.forEach(function (card) {
                            // 检查db--dateList__card类下的子元素是否全部被隐藏
                            let allHidden = true;
                            card.querySelectorAll<HTMLElement>('.db--item').forEach(function (dateListCard) {
                                // 如果存在任何未隐藏的子元素，则将allHidden设置为false
                                if (dateListCard.style.display !== 'none') {
                                    allHidden = false;
                                    card.style.display = '';
                                }
                            });

                            // 如果所有子元素都被隐藏，则隐藏db--list__card元素
                            if (allHidden) {
                                card.style.display = 'none';
                            }
                        });
                    },
                    active: function (el: HTMLElement) {
                        document.querySelectorAll<HTMLElement>('.db--navItem').forEach(function (item) {
                            item.classList.remove('current');
                            item.setAttribute('aria-pressed', 'false');
                        });
                        el.classList.add('current');
                        el.setAttribute('aria-pressed', 'true');
                    }
                };

                document.addEventListener('htmx:beforeRequest', (event) => {
                    const source = (event as CustomEvent<{ elt?: EventTarget }>).detail?.elt;
                    if (source instanceof HTMLElement && source.classList.contains('db--load-more')) {
                        source.remove();
                    }
                });

                document.addEventListener('htmx:afterSwap', (event) => {
                    const target = event.target;
                    if (target instanceof HTMLElement && target.id === 'db--list__card') {
                        douban.change(douban.currentType);
                    }
                });

                document.addEventListener('astro:page-load', () => {
                    document.querySelectorAll<HTMLElement>('.db--navItem').forEach((el) => {
                        el.addEventListener('click', function (e) {
                            const target = e.currentTarget as HTMLElement;
                            douban.change(target.dataset.type ?? 'all');
                            douban.active(target);
                        });
                    });
                });

            </script>

        </div>
    </article>

    <Comments slot="comments" />

    <Relitu slot="relitu" />

    <Fragment slot="toc">
        <Top />
    </Fragment>
</BaseLayout>
