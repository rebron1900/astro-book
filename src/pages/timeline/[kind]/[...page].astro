---
import { timelineVisible, TIMELINE_INCLUDE_NEODB, settings } from '../../../api/store';
import type { TimelineEntry } from '../../../api/store';
import { paginateTimeline, timelineForKind } from '../../../lib/timeline';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Head from '../../../components/islands/Head.astro';
import List from '../../../components/islands/List.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import Relitu from '../../../components/islands/Relitu';
import TocTagloop from '../../../components/islands/TocTagloop.astro';
import Header from '../../../components/layout/Header.astro';
import Top from '../../../components/ui/Top.astro';
import Menu from '../../../components/layout/Menu.astro';

export async function getStaticPaths() {
    // 「阅读与影视」沿用 /timeline/reading/ 这个稳定地址，内容 = reading + media。
    // 书影音是否恢复由 store.ts 的 TIMELINE_INCLUDE_NEODB 控制（true 时重新生成 /timeline/neodb/）。
    const kinds = ['post', 'memo', ...(TIMELINE_INCLUDE_NEODB ? ['neodb'] : []), 'strava', 'reading'];
    const PAGE_SIZE = 10;
    // 按「天」切页（同一天不跨页）与栏目的 kind 映射都放在 src/lib/timeline.ts，
    // 页面只做路径生成；计数口径与页头共用同一套函数，避免各算一套。

    type TimelinePage = {
        data: TimelineEntry[];
        url: { current: string; prev?: string; next?: string };
        currentPage: number;
        lastPage: number;
        start: number;
        end: number;
        total: number;
        size: number;
    };

    const paths: { params: { kind: string; page?: string }; props: { page: TimelinePage } }[] = [];

    for (const kind of kinds) {
        const items = timelineForKind(timelineVisible, kind);
        if (!items.length) continue;

        const pages = paginateTimeline(items, PAGE_SIZE);

        const base = `/timeline/${kind}`;
        pages.forEach((data, index) => {
            const number = index + 1;
            const urlFor = (n: number) => (n === 1 ? `${base}/` : `${base}/${n}`);
            paths.push({
                params: { kind, page: number === 1 ? undefined : String(number) },
                props: {
                    page: {
                        data,
                        url: {
                            current: urlFor(number),
                            prev: number > 1 ? urlFor(number - 1) : undefined,
                            next: number < pages.length ? urlFor(number + 1) : undefined
                        },
                        currentPage: number,
                        lastPage: pages.length,
                        start: 0,
                        end: data.length,
                        total: items.length,
                        size: PAGE_SIZE
                    }
                }
            });
        });
    }

    return paths;
}

const { page } = Astro.props;
const kind = Astro.params.kind ?? 'all';
const kindLabels: Record<string, string> = {
    post: '文章',
    memo: '随记',
    neodb: '书影音',
    strava: '运动',
    reading: '阅读与影视'
};
const title = kindLabels[kind] ?? '时间线';
---

<BaseLayout>
    <Head slot="head" site={settings} title={`${title} | ${settings?.title}`} og_url={import.meta.env.SITE + page.url.current} />

    <Header slot="header" title={settings?.title} />

    <Menu slot="menu" title={page.currentPage != 1 ? `${title} · 第 ${page.currentPage} 页` : title} />

    <List slot="content" page={page} filterKind={kind} isFeature={false} />

    <Pagination slot="pagination" page={page} />

    <Fragment slot="toc">
        <Relitu />
        <TocTagloop />
        <Top />
    </Fragment>

    <Fragment slot="h-toc">
        <aside class="hidden clearfix">
            <Relitu />
            <TocTagloop />
            <Top />
        </aside>
    </Fragment>
</BaseLayout>
